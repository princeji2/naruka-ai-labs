---
interface Props {
  showText?: boolean;
  size?: number;
  class?: string;
}

const { showText = 32, size = 32, class: className = '' } = Astro.props;
---

<div class={`logo-container ${className}`}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 40 40"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="logo-icon"
  >
    <defs>
      <linearGradient id="logoGrad" x1="4" y1="4" x2="36" y2="36" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="var(--accent-indigo-light)" />
        <stop offset="50%" stop-color="var(--accent-indigo)" />
        <stop offset="100%" stop-color="var(--accent-violet)" />
      </linearGradient>
      <linearGradient id="facetGrad" x1="8" y1="12" x2="32" y2="28" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="rgba(255, 255, 255, 0.45)" />
        <stop offset="100%" stop-color="rgba(255, 255, 255, 0.05)" />
      </linearGradient>
    </defs>
    <!-- Outer hexagonal node prism -->
    <rect x="4" y="4" width="32" height="32" rx="10" fill="var(--color-surface-deep)" stroke="url(#logoGrad)" stroke-width="1.75" />
    <!-- Stylized dynamic "N" / AI vector bridge -->
    <path
      d="M13 28V12L20 22L27 12V28"
      stroke="url(#logoGrad)"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <!-- Center focal node -->
    <circle cx="20" cy="22" r="2.5" fill="var(--color-text-primary)" />
  </svg>
  {showText && (
    <div class="logo-text">
      <span class="logo-name">Naruka <span class="logo-tag">AI Labs</span></span>
    </div>
  )}
</div>

<style>
  .logo-container {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    text-decoration: none;
    user-select: none;
  }

  .logo-icon {
    flex-shrink: 0;
    filter: drop-shadow(0 0 var(--space-sm) var(--accent-indigo-glow));
    transition: transform var(--transition-base);
  }

  .logo-container:hover .logo-icon {
    transform: scale(1.05);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: var(--line-height-tight);
  }

  .logo-name {
    font-family: var(--font-display);
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    letter-spacing: var(--letter-spacing-snug);
  }

  .logo-tag {
    font-weight: var(--font-weight-semibold);
    color: var(--accent-indigo-light);
  }
</style>
