---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  /** 'icon' renders a square icon-only button. Pass an aria-label for it. */
  size?: 'sm' | 'md' | 'lg' | 'icon';
  external?: boolean;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  loading?: boolean;
  error?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  type = 'button',
  disabled = false,
  loading = false,
  error = false,
  class: className = '',
  ...rest
} = Astro.props;

const Element = href && !disabled ? 'a' : 'button';
const elementProps = href && !disabled
  ? {
      href,
      target: external ? '_blank' : undefined,
      rel: external ? 'noopener noreferrer' : undefined,
      'aria-disabled': disabled || undefined,
      'aria-busy': loading || undefined,
      ...rest
    }
  : {
      type: href ? undefined : type,
      disabled: disabled || loading,
      'aria-disabled': disabled || undefined,
      'aria-busy': loading || undefined,
      ...rest
    };

const stateClasses = [
  disabled ? 'is-disabled' : '',
  loading ? 'is-loading' : '',
  error ? 'is-error' : ''
].filter(Boolean).join(' ');
---

<Element class={`btn btn-${variant} btn-${size} ${stateClasses} ${className}`} {...elementProps}>
  {loading && (
    <span class="btn-spinner" aria-hidden="true"></span>
  )}
  <slot />
</Element>

<style>
  /* One button shape across the site: 12px radius. Sizes change padding and type only. */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.005em;
    text-decoration: none;
    text-align: center;
    border-radius: var(--radius-md);
    cursor: pointer;
    border: 1px solid transparent;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast),
                transform var(--transition-instant),
                box-shadow var(--transition-fast);
    /* Long labels wrap on narrow screens instead of forcing horizontal scroll */
    white-space: normal;
    max-width: 100%;
    user-select: none;
    min-height: var(--target-min-size);
    position: relative;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }

  /* Sizes */
  .btn-sm {
    padding: var(--space-3) var(--space-5);
    font-size: var(--font-size-sm);
  }

  .btn-md {
    padding: var(--space-4) var(--space-6);
    font-size: var(--font-size-sm);
  }

  .btn-lg {
    min-height: 52px;
    padding: var(--space-4) var(--space-7);
    font-size: var(--font-size-md);
  }

  /* Icon button: square, 44px minimum touch target */
  .btn-icon {
    width: var(--target-min-size);
    padding: 0;
    font-size: var(--font-size-md);
  }

  /* Focus-Visible */
  .btn:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
    border-radius: var(--radius-md);
  }

  /* Press feedback fires on pointer-down, not release.
     This is also the touch-device replacement for hover. */
  .btn:active:not(:disabled):not(.is-disabled) {
    transform: scale(0.97);
  }

  /* Primary: filled green. --on-brand text on --primary is 5.5:1 (white would be ~3:1) */
  .btn-primary {
    background: var(--primary);
    color: var(--on-brand);
    border-color: rgba(var(--white-rgb), 0.14);
    box-shadow: inset 0 1px 0 rgba(var(--white-rgb), 0.22), 0 6px 20px -6px var(--accent-indigo-glow);
  }

  /* Secondary: outline on a quiet glass fill */
  .btn-secondary {
    background: var(--grad-surface-glass);
    color: var(--color-text-primary);
    border-color: var(--border);
    backdrop-filter: blur(var(--glass-blur-sm));
    -webkit-backdrop-filter: blur(var(--glass-blur-sm));
  }

  /* Ghost: text-only until hovered */
  .btn-ghost {
    background: transparent;
    color: var(--color-text-secondary);
  }

  /* Touch devices: :active (above) is the feedback. Hover only where hover exists. */
  @media (hover: hover) and (pointer: fine) {
    .btn-primary:hover:not(:disabled):not(.is-disabled) {
      background: var(--primary-hover);
      box-shadow: inset 0 1px 0 rgba(var(--white-rgb), 0.28), 0 10px 28px -6px var(--accent-indigo-glow);
    }
    .btn-secondary:hover:not(:disabled):not(.is-disabled) {
      background: rgba(var(--white-rgb), 0.08);
      border-color: var(--primary);
    }
    .btn-ghost:hover:not(:disabled):not(.is-disabled) {
      color: var(--color-text-primary);
      background: rgba(var(--white-rgb), 0.06);
    }
  }

  /* Disabled State */
  .btn:disabled,
  .btn.is-disabled {
    opacity: var(--state-disabled-opacity);
    cursor: var(--state-disabled-cursor);
    pointer-events: none;
    box-shadow: none;
    transform: none;
  }

  /* Loading State */
  .btn.is-loading {
    opacity: var(--state-loading-opacity);
    cursor: var(--state-loading-cursor);
    pointer-events: none;
  }

  .btn-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(var(--white-rgb), 0.3);
    border-top-color: currentColor;
    border-radius: var(--radius-full);
    animation: btn-spin 0.6s linear infinite;
    display: inline-block;
  }

  @keyframes btn-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Error State */
  .btn.is-error {
    background: var(--state-error-bg);
    border-color: var(--state-error-border);
    color: var(--state-error-text);
    box-shadow: none;
  }
  .btn.is-error:focus-visible {
    outline: var(--state-error-focus-ring);
  }

  @media (prefers-reduced-transparency: reduce) {
    .btn-secondary {
      background: var(--color-surface-raised);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:active:not(:disabled):not(.is-disabled) {
      transform: none;
    }
    .btn-spinner {
      animation-duration: 1.5s;
    }
  }
</style>
