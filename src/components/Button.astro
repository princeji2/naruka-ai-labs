---
interface Props {
  href?: string;
  /**
   * primary    gradient-stroke pill (outlined, transparent fill)
   * secondary  outlined pill
   * ghost      text only
   * filled     solid fill; reserved for the single hero CTA (wired in Phase 3), used nowhere else
   */
  variant?: 'primary' | 'secondary' | 'ghost' | 'filled';
  /** 'icon' renders a round icon-only button. Pass an aria-label for it. */
  size?: 'sm' | 'md' | 'lg' | 'icon';
  external?: boolean;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  loading?: boolean;
  error?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  type = 'button',
  disabled = false,
  loading = false,
  error = false,
  class: className = '',
  ...rest
} = Astro.props;

const Element = href && !disabled ? 'a' : 'button';
const elementProps = href && !disabled
  ? {
      href,
      target: external ? '_blank' : undefined,
      rel: external ? 'noopener noreferrer' : undefined,
      'aria-disabled': disabled || undefined,
      'aria-busy': loading || undefined,
      ...rest
    }
  : {
      type: href ? undefined : type,
      disabled: disabled || loading,
      'aria-disabled': disabled || undefined,
      'aria-busy': loading || undefined,
      ...rest
    };

const stateClasses = [
  disabled ? 'is-disabled' : '',
  loading ? 'is-loading' : '',
  error ? 'is-error' : ''
].filter(Boolean).join(' ');
---

<Element class={`btn btn-${variant} btn-${size} ${stateClasses} ${className}`} {...elementProps}>
  {loading && (
    <span class="btn-spinner" aria-hidden="true"></span>
  )}
  <slot />
</Element>

<style>
  /* One button shape across the site: a full pill. Sizes change padding and type only.
     No box-shadow on any button. The only solid fill is the `filled` variant (hero CTA). */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.005em;
    text-decoration: none;
    text-align: center;
    border-radius: var(--radius-full);
    cursor: pointer;
    background: transparent;
    border: 1px solid transparent;
    transition: border-color var(--transition-fast),
                color var(--transition-fast),
                opacity var(--transition-fast),
                transform var(--transition-instant);
    /* Long labels wrap on narrow screens instead of forcing horizontal scroll */
    white-space: normal;
    max-width: 100%;
    user-select: none;
    min-height: var(--target-min-size);
    position: relative;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }

  /* Sizes */
  .btn-sm {
    padding: var(--space-3) var(--space-5);
    font-size: var(--font-size-sm);
  }

  .btn-md {
    padding: var(--space-4) var(--space-6);
    font-size: var(--font-size-sm);
  }

  .btn-lg {
    min-height: 52px;
    padding: var(--space-4) var(--space-7);
    font-size: var(--font-size-md);
  }

  /* Icon button: round, 44px minimum touch target */
  .btn-icon {
    width: var(--target-min-size);
    padding: 0;
    font-size: var(--font-size-md);
  }

  /* Focus-Visible */
  .btn:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
    border-radius: var(--radius-full);
  }

  /* Press feedback fires on pointer-down, not release.
     This is also the touch-device replacement for hover. */
  .btn:active:not(:disabled):not(.is-disabled) {
    transform: scale(0.97);
  }

  /* Primary: gradient-stroke pill. Transparent fill, text colour, 1.5px stroke from --grad-studio-brand.
     Fallback (no mask-composite support): a solid --primary border. */
  .btn-primary {
    color: var(--color-text-primary);
    border-width: 1.5px;
    border-color: var(--primary);
  }

  @supports (mask-composite: exclude) or (-webkit-mask-composite: xor) {
    .btn-primary {
      border-color: transparent;
    }
    /* The stroke: a gradient layer on the border box, masked down to a ring of the padding width
       (content-box mask XOR full mask). The radius follows the button, so it stays a clean pill.
       Only opacity animates; the mask colour is irrelevant (only its alpha counts). */
    .btn-primary::before {
      content: '';
      position: absolute;
      inset: -1.5px;
      padding: 1.5px;
      border-radius: inherit;
      background: var(--grad-studio-brand);
      -webkit-mask: linear-gradient(var(--text) 0 0) content-box, linear-gradient(var(--text) 0 0);
      -webkit-mask-composite: xor;
      mask: linear-gradient(var(--text) 0 0) content-box, linear-gradient(var(--text) 0 0);
      mask-composite: exclude;
      opacity: 0.8;
      transition: opacity var(--transition-fast);
      pointer-events: none;
    }
  }

  /* Secondary: outlined pill, transparent fill, text-colour border */
  .btn-secondary {
    color: var(--color-text-primary);
    border-color: var(--text);
  }

  /* Ghost: text only until hovered */
  .btn-ghost {
    color: var(--color-text-secondary);
  }

  /* Filled: the single hero CTA only (wired in Phase 3). Solid fill, no shadow. */
  .btn-filled {
    background: var(--primary);
    color: var(--on-brand);
  }

  /* Touch devices: :active (above) is the feedback. Hover only where hover exists. */
  @media (hover: hover) and (pointer: fine) {
    .btn-primary:hover:not(:disabled):not(.is-disabled)::before {
      opacity: 1;
    }
    .btn-secondary:hover:not(:disabled):not(.is-disabled) {
      border-color: color-mix(in srgb, var(--text) 80%, transparent);
    }
    .btn-ghost:hover:not(:disabled):not(.is-disabled) {
      color: var(--color-text-primary);
    }
    .btn-filled:hover:not(:disabled):not(.is-disabled) {
      background: var(--primary-hover);
    }
  }

  /* Disabled State */
  .btn:disabled,
  .btn.is-disabled {
    opacity: var(--state-disabled-opacity);
    cursor: var(--state-disabled-cursor);
    pointer-events: none;
    transform: none;
  }

  /* Loading State */
  .btn.is-loading {
    opacity: var(--state-loading-opacity);
    cursor: var(--state-loading-cursor);
    pointer-events: none;
  }

  .btn-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(var(--white-rgb), 0.3);
    border-top-color: currentColor;
    border-radius: var(--radius-full);
    animation: btn-spin 0.6s linear infinite;
    display: inline-block;
  }

  @keyframes btn-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Error State: stays outlined, never a fill */
  .btn.is-error {
    background: transparent;
    border-color: var(--state-error-border);
    color: var(--state-error-text);
  }
  .btn.is-error::before {
    display: none;
  }
  .btn.is-error:focus-visible {
    outline: var(--state-error-focus-ring);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:active:not(:disabled):not(.is-disabled) {
      transform: none;
    }
    .btn-spinner {
      animation-duration: 1.5s;
    }
  }
</style>
