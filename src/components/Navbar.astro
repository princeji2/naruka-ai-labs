---
import Logo from './Logo.astro';
import Button from './Button.astro';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/products', label: 'Products' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header" id="site-header">
  <div class="container header-container">
    <a href="/" class="brand-link" aria-label="Naruka AI Labs Home">
      <Logo size={32} />
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class={`nav-link ${isActive(link.href) ? 'active' : ''}`}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a
        href="https://github.com/princeji2/naruka-ai-labs"
        target="_blank"
        rel="noopener noreferrer"
        class="github-icon-link"
        aria-label="Naruka AI Labs on GitHub"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
        </svg>
      </a>
      <Button href="mailto:naruka@orgs.social" variant="secondary" size="sm" class="header-cta">
        naruka@orgs.social
      </Button>

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        class="mobile-toggle"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Open navigation menu"
      >
        <span class="hamburger-box">
          <span class="hamburger-inner"></span>
        </span>
      </button>
    </div>
  </div>
</header>

  <!-- Mobile Drawer Overlay & Panel.
       Lives outside <header>: the header's backdrop-filter would otherwise become the
       containing block for this fixed layer and clip it to the 72px bar. -->
  <div class="mobile-drawer" id="mobile-nav-drawer" aria-hidden="true">
    <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop"></div>
    <div class="mobile-drawer-content" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
      <div class="mobile-drawer-header">
        <Logo size={28} />
        <button
          type="button"
          class="mobile-close-btn"
          id="mobile-close-btn"
          aria-label="Close navigation menu"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="mobile-nav-links" aria-label="Mobile Menu Links">
        <ul>
          <li>
            <a href="/" class={`mobile-nav-link ${currentPath === '/' ? 'active' : ''}`}>Home</a>
          </li>
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={`mobile-nav-link ${isActive(link.href) ? 'active' : ''}`}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mobile-drawer-footer">
        <a href="mailto:naruka@orgs.social" class="mobile-contact-card">
          <span class="mobile-contact-label">Get in touch</span>
          <span class="mobile-contact-value">naruka@orgs.social</span>
        </a>
        <div class="mobile-social-links">
          <a
            href="https://github.com/princeji2/naruka-ai-labs"
            target="_blank"
            rel="noopener noreferrer"
            class="mobile-social-link"
          >
            GitHub
          </a>
          <span class="sep">·</span>
          <a
            href="https://www.linkedin.com/in/prince-naruka-26581236b/"
            target="_blank"
            rel="noopener noreferrer"
            class="mobile-social-link"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </div>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const closeBtn = document.getElementById('mobile-close-btn');
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    const drawer = document.getElementById('mobile-nav-drawer');

    if (!toggleBtn || !drawer) return;

    let isOpen = false;

    function getFocusable() {
      if (!drawer) return [];
      return Array.from(
        drawer.querySelectorAll<HTMLElement>(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
        )
      );
    }

    function openMenu() {
      isOpen = true;
      toggleBtn?.setAttribute('aria-expanded', 'true');
      drawer?.setAttribute('aria-hidden', 'false');
      drawer?.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      // Focus the close button after transition starts
      setTimeout(() => {
        closeBtn?.focus();
      }, 50);
    }

    function closeMenu() {
      isOpen = false;
      toggleBtn?.setAttribute('aria-expanded', 'false');
      drawer?.setAttribute('aria-hidden', 'true');
      drawer?.classList.remove('is-open');
      document.body.style.overflow = '';
      toggleBtn?.focus();
    }

    toggleBtn.addEventListener('click', () => {
      if (isOpen) closeMenu();
      else openMenu();
    });

    closeBtn?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);

    // Trap focus inside drawer and handle Escape key
    window.addEventListener('keydown', (e) => {
      if (!isOpen) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeMenu();
        return;
      }

      if (e.key === 'Tab') {
        const focusable = getFocusable();
        if (focusable.length === 0) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === first) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    });

    // Close when clicking internal links
    const mobileLinks = drawer.querySelectorAll('.mobile-nav-link');
    mobileLinks.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(var(--bg-rgb), 0.72);
    backdrop-filter: blur(var(--glass-blur-lg)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur-lg)) saturate(160%);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Hairline highlight under the bar instead of a hard divider */
  .site-header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(var(--primary-rgb), 0.28) 50%, transparent 100%);
    pointer-events: none;
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--color-surface-base);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    border-radius: var(--radius-xs);
  }
  .brand-link:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    border-radius: var(--radius-full);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--color-text-primary);
      background: rgba(var(--white-rgb), 0.06);
    }
  }

  /* Weight stays constant between states so the label never shifts width */
  .nav-link.active {
    color: var(--color-text-primary);
    background: rgba(var(--primary-rgb), 0.14);
    box-shadow: inset 0 0 0 1px rgba(var(--primary-rgb), 0.3);
  }

  .nav-link:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .github-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--target-min-size);
    height: var(--target-min-size);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    border: 1px solid var(--border-subtle);
    background: rgba(var(--white-rgb), 0.02);
    transition: color var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .github-icon-link:hover {
      color: var(--color-text-primary);
      border-color: var(--border-glass-hover);
      background: rgba(var(--white-rgb), 0.06);
    }
  }

  .github-icon-link:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  .header-cta {
    display: none;
  }

  @media (min-width: 640px) {
    .header-cta {
      display: inline-flex;
    }
  }

  /* Mobile Toggle Button */
  .mobile-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--target-min-size);
    height: var(--target-min-size);
    background: rgba(var(--white-rgb), 0.04);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-full);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .mobile-toggle:active {
    background: rgba(var(--white-rgb), 0.1);
  }

  .mobile-toggle:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  @media (min-width: 768px) {
    .mobile-toggle {
      display: none;
    }
  }

  .hamburger-box {
    width: 20px;
    height: 14px;
    position: relative;
    display: inline-block;
  }

  .hamburger-inner,
  .hamburger-inner::before,
  .hamburger-inner::after {
    width: 20px;
    height: 2px;
    background-color: var(--color-text-primary);
    border-radius: var(--radius-xs);
    position: absolute;
    left: 0;
    transition: transform var(--transition-fast);
  }

  .hamburger-inner {
    top: 50%;
    transform: translateY(-50%);
  }

  .hamburger-inner::before {
    content: '';
    top: -6px;
  }

  .hamburger-inner::after {
    content: '';
    bottom: -6px;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 200;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0.28s linear;
  }

  .mobile-drawer.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(var(--black-rgb), 0.7);
    backdrop-filter: blur(var(--glass-blur-sm));
    -webkit-backdrop-filter: blur(var(--glass-blur-sm));
    opacity: 0;
    transition: opacity 0.28s var(--ease-out);
  }

  .mobile-drawer.is-open .mobile-drawer-backdrop {
    opacity: 1;
  }

  .mobile-drawer-content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(85vw, 360px);
    background: var(--color-surface-card);
    border-left: 1px solid var(--border-glass);
    padding: var(--space-xl) var(--space-lg);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.28s var(--ease-drawer);
    box-shadow: -10px 0 30px rgba(var(--black-rgb), 0.7);
  }

  .mobile-drawer.is-open .mobile-drawer-content {
    transform: translateX(0);
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2xl);
  }

  .mobile-close-btn {
    width: var(--target-min-size);
    height: var(--target-min-size);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(var(--white-rgb), 0.05);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-full);
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .mobile-close-btn:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  .mobile-nav-links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    padding: var(--space-sm) var(--space-md);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
    min-height: var(--target-min-size);
  }

  .mobile-nav-link.active {
    color: var(--color-text-primary);
    background: rgba(var(--primary-rgb), 0.12);
    border-left: 3px solid var(--accent-indigo);
  }

  .mobile-nav-link:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  .mobile-drawer-footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border-subtle);
  }

  .mobile-contact-card {
    padding: var(--space-md);
    background: rgba(var(--white-rgb), 0.03);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mobile-contact-card:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  .mobile-contact-label {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-muted);
  }

  .mobile-contact-value {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--accent-indigo-light);
  }

  .mobile-social-links {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .mobile-social-link {
    border-radius: var(--radius-xs);
  }

  .mobile-social-link:hover {
    color: var(--color-text-primary);
  }

  .mobile-social-link:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  .sep {
    color: var(--color-text-muted);
  }
</style>
