---
interface Props {
  variant?: 'in-development' | 'live-prototype' | 'demo-data' | 'planned' | 'neutral';
  text?: string;
  class?: string;
}

const { variant = 'in-development', text, class: className = '' } = Astro.props;

const defaultTexts: Record<string, string> = {
  'in-development': 'In Active Development',
  'live-prototype': 'Live Prototype',
  'demo-data': 'Demo Data / Simulated',
  'planned': 'Planned / Concept',
  'neutral': 'Studio Project'
};

const displayText = text || defaultTexts[variant];
---

<span class={`badge badge-${variant} ${className}`}>
  <span class="badge-dot" aria-hidden="true"></span>
  <span class="badge-label">{displayText}</span>
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    width: fit-content;
    max-width: 100%;
    white-space: nowrap;
    box-sizing: border-box;
    user-select: none;
    line-height: 1;
  }

  .badge-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .badge-dot {
    width: var(--space-3);
    height: var(--space-3);
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  /* In Development */
  .badge-in-development {
    background: rgba(99, 102, 241, 0.12);
    color: var(--accent-indigo-light);
    border: 1px solid rgba(99, 102, 241, 0.28);
  }
  .badge-in-development .badge-dot {
    background: var(--accent-indigo-light);
    box-shadow: 0 0 var(--space-sm) var(--accent-indigo);
  }

  /* Live Prototype */
  .badge-live-prototype {
    background: var(--setu-emerald-bg);
    color: var(--setu-emerald-light);
    border: 1px solid var(--setu-emerald-border);
  }
  .badge-live-prototype .badge-dot {
    background: var(--setu-emerald);
    box-shadow: 0 0 var(--space-sm) var(--setu-emerald);
  }

  /* Demo Data / Simulated */
  .badge-demo-data {
    background: var(--fieldbook-amber-bg);
    color: var(--fieldbook-amber-light);
    border: 1px solid var(--fieldbook-amber-border);
  }
  .badge-demo-data .badge-dot {
    background: var(--fieldbook-amber);
    box-shadow: 0 0 var(--space-sm) var(--fieldbook-amber);
  }

  /* Planned / Concept */
  .badge-planned {
    background: rgba(148, 163, 184, 0.10);
    color: var(--color-text-secondary);
    border: 1px solid rgba(148, 163, 184, 0.22);
  }
  .badge-planned .badge-dot {
    background: var(--color-text-muted);
  }

  /* Neutral */
  .badge-neutral {
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-secondary);
    border: 1px solid var(--border-glass);
  }
  .badge-neutral .badge-dot {
    background: var(--color-text-muted);
  }
</style>
