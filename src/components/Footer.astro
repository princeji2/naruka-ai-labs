---
import Logo from './Logo.astro';
---

<footer class="site-footer" id="site-footer">
  <div class="container footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo-link" aria-label="Naruka AI Labs Home">
          <Logo size={28} />
        </a>
        <p class="footer-tagline">
          An independent, founder-led AI product studio building practical, domain-focused software.
        </p>
        <div class="footer-contact-item">
          <span class="label">Inquiries & Contact:</span>
          <a href="mailto:naruka@orgs.social" class="email-link">naruka@orgs.social</a>
        </div>
      </div>

      <div class="footer-nav-grid">
        <div class="footer-col" data-reveal>
          <p class="footer-col-title">Products</p>
          <ul class="footer-link-list">
            <li><a href="/products/setu" class="footer-link">Setu (Interoperability Gateway)</a></li>
            <li><a href="/products/field-book" class="footer-link">Field Book (Attendance Ledger)</a></li>
            <li><a href="/products" class="footer-link">Products Overview</a></li>
          </ul>
        </div>

        <div class="footer-col" data-reveal>
          <p class="footer-col-title">Studio</p>
          <ul class="footer-link-list">
            <li><a href="/about" class="footer-link">About Studio</a></li>
            <li><a href="/contact" class="footer-link">Contact & Inquiries</a></li>
            <li>
              <a href="https://github.com/princeji2/naruka-ai-labs" target="_blank" rel="noopener noreferrer" class="footer-link">
                GitHub Repository
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/in/prince-naruka-26581236b/" target="_blank" rel="noopener noreferrer" class="footer-link">
                Founder LinkedIn
              </a>
            </li>
          </ul>
        </div>

        <div class="footer-col" data-reveal>
          <p class="footer-col-title">Legal & Trust</p>
          <ul class="footer-link-list">
            <li><a href="/privacy" class="footer-link">Privacy Policy</a></li>
            <li><a href="/terms" class="footer-link">Terms of Service</a></li>
            <li>
              <span class="host-pill">Hosted on Vercel · orgs.social</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Studio Notice -->
    <div class="footer-disclosure">
      <p>
        <strong>Studio Disclosure:</strong> Naruka AI Labs is an early-stage, founder-led software venture founded by Prince Naruka. 
        Setu originated as a Smart India Hackathon project (SIH 26129) and operates with simulated demo backends; it is not affiliated with or endorsed by government agencies. 
        Field Book is an active campus attendance & certificate verification prototype.
      </p>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © 2026 Naruka AI Labs. Website open source under MIT License. Product code and trademarks separate.
      </p>
      <div class="footer-badges">
        <span class="status-indicator">
          <span class="pulse-dot"></span>
          Early-Stage Product Studio
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Flat footer: one surface step lighter than the page, 1px hairline divider on top.
     Depth comes from the surface step, so there is no gradient, blur or shadow. */
  .site-footer {
    background: color-mix(in srgb, var(--bg) 70%, var(--surface));
    border-top: 1px solid var(--border);
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-2xl);
    margin-top: auto;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 860px) {
    .footer-top {
      grid-template-columns: 1.3fr 2fr;
      gap: var(--space-3xl);
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 380px;
  }

  .footer-logo-link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: var(--target-min-size);
    border-radius: var(--radius-xs);
  }

  .footer-logo-link:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  .footer-tagline {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .footer-contact-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-xs);
  }

  .footer-contact-item .label {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .email-link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: var(--target-min-size);
    font-size: var(--font-size-md);
    color: var(--color-text-brand);
    font-weight: var(--font-weight-medium);
    border-radius: var(--radius-xs);
    transition: color var(--transition-fast);
  }

  .email-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .email-link:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  .footer-nav-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-xl);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* Curly-bracket signature. Generated content with empty alt text: the DOM text is unchanged
     and screen readers do not read the braces. The plain declaration is the fallback for engines
     that do not support the alt-text syntax. */
  .footer-col-title::before,
  .footer-disclosure strong::before {
    content: '{ ';
    content: '{ ' / '';
  }

  .footer-col-title::after,
  .footer-disclosure strong::after {
    content: ' }';
    content: ' }' / '';
  }

  .footer-col-title {
    font-size: var(--font-size-base);
    color: var(--color-text-primary);
    font-weight: var(--font-weight-regular);
  }

  .footer-link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min-size);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    border-radius: var(--radius-xs);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-link:hover {
      color: var(--color-text-primary);
    }
  }

  .footer-link:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  .host-pill {
    display: inline-block;
    font-size: var(--font-size-xs);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
  }

  /* Disclosure: outlined, no fill */
  .footer-disclosure {
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .footer-disclosure p {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .footer-disclosure strong {
    color: var(--color-text-secondary);
  }

  /* Footer Bottom */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-subtle);
    align-items: flex-start;
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .copyright {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .footer-badges {
    display: flex;
    align-items: center;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    white-space: nowrap;
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    border: 1px solid var(--border);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
  }

  .pulse-dot {
    width: var(--space-3);
    height: var(--space-3);
    border-radius: var(--radius-full);
    background: var(--accent-indigo-light);
  }
</style>
