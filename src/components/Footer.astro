---
import Logo from './Logo.astro';
---

<footer class="site-footer" id="site-footer">
  <div class="container footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo-link" aria-label="Naruka AI Labs Home">
          <Logo size={28} />
        </a>
        <p class="footer-tagline">
          An independent, founder-led AI product studio building practical, domain-focused software.
        </p>
        <div class="footer-contact-item">
          <span class="label">Inquiries & Contact:</span>
          <a href="mailto:naruka@orgs.social" class="email-link">naruka@orgs.social</a>
        </div>
      </div>

      <div class="footer-nav-grid">
        <div class="footer-col">
          <p class="footer-col-title">Products</p>
          <ul class="footer-link-list">
            <li><a href="/products/setu" class="footer-link">Setu (Interoperability Gateway)</a></li>
            <li><a href="/products/field-book" class="footer-link">Field Book (Attendance Ledger)</a></li>
            <li><a href="/products" class="footer-link">Products Overview</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <p class="footer-col-title">Studio</p>
          <ul class="footer-link-list">
            <li><a href="/about" class="footer-link">About Studio</a></li>
            <li><a href="/contact" class="footer-link">Contact & Inquiries</a></li>
            <li>
              <a href="https://github.com/princeji2/naruka-ai-labs" target="_blank" rel="noopener noreferrer" class="footer-link">
                GitHub Repository
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/in/prince-naruka-26581236b/" target="_blank" rel="noopener noreferrer" class="footer-link">
                Founder LinkedIn
              </a>
            </li>
          </ul>
        </div>

        <div class="footer-col">
          <p class="footer-col-title">Legal & Trust</p>
          <ul class="footer-link-list">
            <li><a href="/privacy" class="footer-link">Privacy Policy</a></li>
            <li><a href="/terms" class="footer-link">Terms of Service</a></li>
            <li>
              <span class="host-pill">Hosted on Vercel · orgs.social</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Studio Notice -->
    <div class="footer-disclosure">
      <p>
        <strong>Studio Disclosure:</strong> Naruka AI Labs is an early-stage, founder-led software venture founded by Prince Naruka. 
        Setu originated as a Smart India Hackathon project (SIH 26129) and operates with simulated demo backends; it is not affiliated with or endorsed by government agencies. 
        Field Book is an active campus attendance & certificate verification prototype.
      </p>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © 2026 Naruka AI Labs. Website open source under MIT License. Product code and trademarks separate.
      </p>
      <div class="footer-badges">
        <span class="status-indicator">
          <span class="pulse-dot"></span>
          Early-Stage Product Studio
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Glass footer: translucent fill + blur, same material as the header */
  .site-footer {
    position: relative;
    background: linear-gradient(180deg, rgba(var(--bg-rgb), 0.6) 0%, rgba(var(--bg-rgb), 0.88) 100%);
    backdrop-filter: blur(var(--glass-blur-md)) saturate(140%);
    -webkit-backdrop-filter: blur(var(--glass-blur-md)) saturate(140%);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-2xl);
    margin-top: auto;
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-footer {
      background: var(--color-surface-deep);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  /* Hairline highlight, same device as the header */
  .site-footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(var(--primary-rgb), 0.24) 50%, transparent 100%);
    pointer-events: none;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 860px) {
    .footer-top {
      grid-template-columns: 1.3fr 2fr;
      gap: var(--space-3xl);
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 380px;
  }

  .footer-logo-link {
    display: inline-block;
    border-radius: var(--radius-xs);
  }

  .footer-logo-link:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  .footer-tagline {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .footer-contact-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-xs);
  }

  .footer-contact-item .label {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-muted);
  }

  .email-link {
    font-size: var(--font-size-md);
    color: var(--accent-indigo-light);
    font-weight: var(--font-weight-medium);
    border-radius: var(--radius-xs);
  }

  .email-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .email-link:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  .footer-nav-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-xl);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .footer-col-title {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-muted);
    font-weight: var(--font-weight-medium);
  }

  .footer-link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-link {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    border-radius: var(--radius-xs);
    display: inline-block;
    padding: var(--space-1) 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-link:hover {
      color: var(--color-text-primary);
    }
  }

  .footer-link:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  .host-pill {
    display: inline-block;
    font-size: var(--font-size-xs);
    padding: var(--space-1) var(--space-3);
    background: rgba(var(--white-rgb), 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xs);
    color: var(--color-text-muted);
  }

  /* Disclosure */
  .footer-disclosure {
    padding: var(--space-md) var(--space-lg);
    background: rgba(var(--white-rgb), 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .footer-disclosure p {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .footer-disclosure strong {
    color: var(--color-text-secondary);
  }

  /* Footer Bottom */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-subtle);
    align-items: flex-start;
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .copyright {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .footer-badges {
    display: flex;
    align-items: center;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    white-space: nowrap;
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    background: rgba(var(--primary-rgb), 0.08);
    border: 1px solid rgba(var(--primary-rgb), 0.2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
  }

  .pulse-dot {
    width: var(--space-3);
    height: var(--space-3);
    border-radius: var(--radius-full);
    background: var(--accent-indigo-light);
    box-shadow: 0 0 var(--space-3) var(--accent-indigo);
  }
</style>
