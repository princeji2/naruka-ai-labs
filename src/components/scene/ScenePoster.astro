---
// ScenePoster.astro: static, token-coloured poster for Scene_3D (lifted from HeroPrism's CSS layer).
// No script, no network, no image. It sits under the canvas layer and stays visible whenever the
// island is slow, fails, WebGL is unavailable, or the quality tier is `poster`.
// Every colour comes from Design_Tokens.
//
// The visible striped rectangle the hero used to sit in came from this poster: the hard top
// hairline, the full-opacity vertical flutes, and the hard box edges. It is now frameless — a radial
// mask on .scene-poster (and on .scene in Scene3D.astro) fades every edge, the top hairline is gone,
// and the flutes are faint internal texture only.
---

<div class="scene-poster" aria-hidden="true">
  <div class="poster-glow poster-glow-primary"></div>
  <div class="poster-glow poster-glow-secondary"></div>
  <div class="poster-flutes"></div>
</div>

<style>
  .scene-poster {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Radial mask fades every edge so the scene has no visible rectangle or frame:
       fully opaque at the centre, transparent before it reaches any edge. */
    -webkit-mask-image: radial-gradient(ellipse 72% 72% at 50% 42%, rgb(var(--black-rgb)) 0%, rgb(var(--black-rgb)) 45%, transparent 100%);
    mask-image: radial-gradient(ellipse 72% 72% at 50% 42%, rgb(var(--black-rgb)) 0%, rgb(var(--black-rgb)) 45%, transparent 100%);
  }

  .poster-glow {
    position: absolute;
    border-radius: var(--radius-full);
    filter: blur(var(--glass-blur-lg));
    opacity: 0.65;
  }

  .poster-glow-primary {
    top: -10%;
    right: 5%;
    width: 70%;
    aspect-ratio: 1 / 1;
    background: radial-gradient(circle, rgba(var(--primary-rgb), 0.24) 0%, rgba(var(--accent-rgb), 0.12) 50%, transparent 75%);
  }

  .poster-glow-secondary {
    bottom: -5%;
    left: 0;
    width: 60%;
    aspect-ratio: 1 / 1;
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.18) 0%, rgba(var(--secondary-rgb), 0.08) 55%, transparent 75%);
  }

  /* Faint vertical flutes. Kept very subtle and edge-faded so they read as internal texture
     on the glow, never as a striped rectangle. The radial mask on .scene-poster fades the ends. */
  .poster-flutes {
    position: absolute;
    inset: 0;
    opacity: 0.25;
    background-image: repeating-linear-gradient(
      90deg,
      rgba(var(--white-rgb), 0.02) 0px,
      rgba(var(--white-rgb), 0.008) 6px,
      rgba(var(--black-rgb), 0.14) 12px,
      rgba(var(--white-rgb), 0.025) 16px
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .poster-glow {
      filter: blur(20px);
    }
  }
</style>
