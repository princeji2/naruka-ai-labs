---
/**
 * Background.astro
 *
 * Site-wide animated background. Reproduces the look of refrence/background.txt (particles-bg.tsx):
 * drifting dots, thin links, hover "grab" lines and click "push", drawn by a bundled, typed canvas-2D
 * module (src/lib/background/). Adaptations:
 *   1. The particles.js script (jsDelivr CDN in the reference, then vendored) is replaced by the
 *      bundled module. public/vendor/particles.min.js is gone, so script-src 'self' stays untouched.
 *   2. The reference @ts-ignore directives are gone; everything is typed.
 *   3. The reference hex colours are replaced by Design_Tokens: particles use --accent, links and
 *      strokes use --secondary (read once through the token bridge), the gradient uses tokens.
 *   4. Dark-only: the reference light colour set and its MutationObserver are dropped.
 *   5. The wrapper is fixed and sits behind every page. Pointer events are read from window, so the
 *      old synthetic-event forwarding is not needed.
 *   6. Reduced motion draws one static frame. Drawing pauses while the tab is hidden.
 *   7. A scrim (--background-scrim) sits between the gradient and the canvas so text keeps contrast.
 *      Set it to 0 to disable.
 */
---

<div class="site-background" aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  import { bindPageLifecycle, createGate, type Cleanup } from '../../lib/lifecycle/page-lifecycle.ts';
  import { createTokenReader } from '../../lib/theme/tokens.ts';
  import { MOTION_QUERIES } from '../../lib/scroll/scroll-controller.ts';
  import {
    capParticles,
    createParticles,
    particleCountForArea,
    push,
    resizeField,
    step,
    type Bounds,
    type Particle,
    type Point,
  } from '../../lib/background/particle-field.ts';
  import { MOBILE_QUERY, POINTER_QUERY, readQualityInput, resolveQuality } from '../../lib/background/quality.ts';
  import { clearField, drawField, fitCanvas, type BackgroundPalette } from '../../lib/background/render.ts';

  /** A click on any of these does not push particles. */
  const INTERACTIVE = 'a, button, input, select, textarea, summary, label, [role="button"]';

  function setupBackground(): Cleanup | void {
    // Fresh lookup on every enter, so a swapped-in page gets its own canvas.
    const canvas = document.querySelector<HTMLCanvasElement>('.site-background canvas');
    const ctx = canvas?.getContext('2d') ?? null;
    if (canvas === null || ctx === null) return;

    let palette: BackgroundPalette;
    try {
      const tokens = createTokenReader(document);
      palette = {
        particle: tokens.color('--accent'),
        link: tokens.color('--secondary'),
        stroke: tokens.color('--secondary'),
      };
    } catch (error) {
      // The gradient alone stays visible when a token is missing.
      if (import.meta.env.DEV) console.warn('[background] token not available, canvas disabled', error);
      return;
    }

    const wrapper = canvas.parentElement ?? canvas;
    const controller = new AbortController();
    const { signal } = controller;

    let quality = resolveQuality(readQualityInput(window));
    let particles: Particle[] = [];
    let bounds: Bounds = { width: 0, height: 0 };
    let sizedDpr = 0;
    let pointer: Point | null = null;
    let frameId = 0;
    let lastTime = 0;

    const drawStatic = (): void => {
      drawField(ctx, particles, bounds, palette, quality.config, quality.pointerFeatures ? pointer : null);
    };

    /** Sizes the canvas and fits the particle count to the area. Skipped when nothing changed. */
    const applySize = (width: number, height: number, force: boolean): void => {
      const cssWidth = Math.floor(width);
      const cssHeight = Math.floor(height);
      if (!force && cssWidth === bounds.width && cssHeight === bounds.height && quality.dpr === sizedDpr) return;
      bounds = fitCanvas(canvas, ctx, cssWidth, cssHeight, quality.dpr);
      sizedDpr = quality.dpr;
      const target = particleCountForArea(bounds, quality.config);
      if (particles.length === 0) particles = createParticles(bounds, target, Math.random, quality.config);
      else resizeField(particles, bounds, target, Math.random, quality.config);
      // Resizing the backing store clears it, so redraw at once.
      drawStatic();
    };

    const frame = (now: number): void => {
      frameId = 0;
      if (document.hidden || !quality.animate) return;
      step(particles, bounds, now - lastTime, quality.config);
      lastTime = now;
      drawField(ctx, particles, bounds, palette, quality.config, quality.pointerFeatures ? pointer : null);
      frameId = requestAnimationFrame(frame);
    };

    const start = (): void => {
      if (frameId !== 0 || document.hidden || !quality.animate) return;
      lastTime = performance.now();
      frameId = requestAnimationFrame(frame);
    };

    const stop = (): void => {
      if (frameId !== 0) cancelAnimationFrame(frameId);
      frameId = 0;
    };

    const measure = (): void => applySize(wrapper.clientWidth, wrapper.clientHeight, false);

    /** Re-reads the viewport class and motion preference, then re-fits everything. */
    const refreshQuality = (): void => {
      quality = resolveQuality(readQualityInput(window));
      if (!quality.pointerFeatures) pointer = null;
      applySize(wrapper.clientWidth, wrapper.clientHeight, true);
      if (quality.animate) start();
      else stop();
    };

    // Initial size and first frame, then the animation loop (reduced motion keeps the static frame).
    applySize(wrapper.clientWidth, wrapper.clientHeight, true);
    start();

    const observer = new ResizeObserver(measure);
    observer.observe(wrapper);

    window.addEventListener('resize', measure, { passive: true, signal });
    window.addEventListener(
      'pointermove',
      (event: PointerEvent) => {
        if (!quality.pointerFeatures) return;
        pointer = { x: event.clientX, y: event.clientY };
      },
      { passive: true, signal },
    );
    document.documentElement.addEventListener(
      'pointerleave',
      () => {
        pointer = null;
      },
      { passive: true, signal },
    );
    window.addEventListener(
      'pointerdown',
      (event: PointerEvent) => {
        if (!quality.pointerFeatures || !event.isPrimary) return;
        // Clicking a link or button should not also spawn particles.
        if (event.target instanceof Element && event.target.closest(INTERACTIVE) !== null) return;
        push(particles, { x: event.clientX, y: event.clientY }, quality.config.pushCount, Math.random, quality.config, bounds);
        capParticles(particles, quality.config.maxCount);
      },
      { passive: true, signal },
    );
    document.addEventListener(
      'visibilitychange',
      () => {
        if (document.hidden) stop();
        else start();
      },
      { signal },
    );
    for (const query of [MOBILE_QUERY, POINTER_QUERY, MOTION_QUERIES.reduced]) {
      window.matchMedia(query).addEventListener('change', refreshQuality, { signal });
    }

    return () => {
      controller.abort();
      stop();
      observer.disconnect();
      clearField(ctx, bounds);
      particles = [];
      pointer = null;
    };
  }

  bindPageLifecycle(createGate(setupBackground), { document, window });
</script>

<style>
  /* Fixed wrapper: keeps the background behind all pages while scrolling. */
  .site-background {
    --background-scrim: 0.7;
    position: fixed;
    inset: 0;
    z-index: -3;
    overflow: hidden;
    pointer-events: none;
    background-image: linear-gradient(
      to top right,
      var(--color-surface-deep),
      var(--bg),
      color-mix(in srgb, var(--secondary) 30%, var(--bg))
    );
  }

  /* Scrim: darkens the gradient only (the canvas is lifted above it) for text contrast. */
  .site-background::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(var(--bg-rgb), var(--background-scrim));
    z-index: 0;
    pointer-events: none;
  }

  .site-background canvas {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
