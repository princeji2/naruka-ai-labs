---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
---

<BaseLayout
  title="Contact & Inquiries"
  description="Contact Naruka AI Labs. Reach founder Prince Naruka directly at naruka@orgs.social for program evaluations, engineering collaborations, or inquiries."
  canonicalPath="/contact"
>
  <div class="contact-page">
    <section class="section contact-hero-section">
      <div class="container contact-container">
        <Badge variant="in-development" text="Direct Studio Channel" />
        <h1 class="contact-title">
          Get in touch with <br />
          <span class="text-gradient-brand">Naruka AI Labs</span>.
        </h1>
        <p class="contact-lead">
          We welcome direct conversations regarding our products, architectural reviews, and technical collaborations.
        </p>

        <!-- Direct Contact Cards -->
        <div class="channels-grid">
          <!-- Primary Email Card -->
          <div class="channel-card glass-panel primary-card">
            <div class="channel-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="channel-body">
              <span class="channel-label">Primary Direct Email</span>
              <a href="mailto:naruka@orgs.social" class="channel-main-link">
                naruka@orgs.social
              </a>
              <p class="channel-note">
                Direct mailbox of founder Prince Naruka. Verified on domain <code>orgs.social</code>.
              </p>
            </div>
            <div class="channel-action">
              <Button href="mailto:naruka@orgs.social" variant="primary" size="md">
                Compose Email ↗
              </Button>
              <button
                type="button"
                class="copy-email-btn"
                id="copy-btn"
                aria-label="Copy Address: naruka@orgs.social"
              >
                <span id="copy-text">Copy Address</span>
              </button>
            </div>
          </div>

          <!-- Secondary Channels Grid -->
          <div class="secondary-channels">
            <!-- GitHub -->
            <a
              href="https://github.com/princeji2/naruka-ai-labs"
              target="_blank"
              rel="noopener noreferrer"
              class="sub-channel-card glass-panel"
            >
              <div class="sub-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                </svg>
              </div>
              <div class="sub-info">
                <span class="sub-title">GitHub Repository</span>
                <span class="sub-desc">github.com/princeji2/naruka-ai-labs ↗</span>
              </div>
            </a>

            <!-- LinkedIn -->
            <a
              href="https://www.linkedin.com/in/prince-naruka-26581236b/"
              target="_blank"
              rel="noopener noreferrer"
              class="sub-channel-card glass-panel"
            >
              <div class="sub-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect x="2" y="9" width="4" height="12"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </div>
              <div class="sub-info">
                <span class="sub-title">Founder LinkedIn</span>
                <span class="sub-desc">linkedin.com/in/prince-naruka-26581236b ↗</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Inquiries Advisory -->
        <div class="inquiry-info-box glass-panel">
          <h2 class="info-title">What to Expect</h2>
          <div class="info-columns">
            <div class="info-col">
              <strong>Technical Inquiries:</strong> If you are interested in exploring our system architectures, testing product prototypes, or discussing engineering collaborations, please feel free to reach out.
            </div>
            <div class="info-col">
              <strong>Response Timeline:</strong> As an active engineering studio, all incoming emails are monitored directly by Prince Naruka. You can typically expect a response within 24 to 48 hours.
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  function setupCopyButton() {
    const copyBtn = document.getElementById('copy-btn');
    const copyText = document.getElementById('copy-text');
    if (!copyBtn || !copyText) return;

    copyBtn.addEventListener('click', async () => {
      copyBtn.setAttribute('aria-busy', 'true');
      try {
        if (!navigator.clipboard || !navigator.clipboard.writeText) {
          throw new Error('Clipboard API not supported');
        }
        await navigator.clipboard.writeText('naruka@orgs.social');
        copyText.textContent = 'Copied to Clipboard!';
        copyBtn.classList.remove('is-error');
        copyBtn.classList.add('copied');
        setTimeout(() => {
          copyText.textContent = 'Copy Address';
          copyBtn.classList.remove('copied');
          copyBtn.removeAttribute('aria-busy');
        }, 2200);
      } catch (err) {
        console.warn('Clipboard write failed:', err);
        copyText.textContent = 'Copy Failed — Select Below';
        copyBtn.classList.remove('copied');
        copyBtn.classList.add('is-error');
        setTimeout(() => {
          copyText.textContent = 'Copy Address';
          copyBtn.classList.remove('is-error');
          copyBtn.removeAttribute('aria-busy');
        }, 3000);
      }
    });
  }

  setupCopyButton();
  document.addEventListener('astro:after-swap', setupCopyButton);
</script>

<style>
  .contact-page {
    padding-bottom: var(--space-4xl);
  }

  .contact-hero-section {
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-3xl);
  }

  .contact-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-md);
    max-width: 860px;
  }

  .contact-title {
    font-size: var(--font-size-6xl);
    line-height: var(--line-height-tight);
  }

  .contact-lead {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 680px;
    margin-bottom: var(--space-xl);
  }

  /* Channels Grid */
  .channels-grid {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    text-align: left;
    margin-bottom: var(--space-2xl);
  }

  .primary-card {
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl));
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    background: radial-gradient(circle at 10% 20%, rgba(99, 102, 241, 0.12), rgba(14, 18, 27, 0.6) 80%);
    border: 1px solid rgba(99, 102, 241, 0.3);
  }

  @media (min-width: 768px) {
    .primary-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .channel-icon {
    width: var(--space-8);
    height: var(--space-8);
    border-radius: var(--radius-md);
    background: rgba(99, 102, 241, 0.15);
    color: var(--accent-indigo-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .channel-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 1;
  }

  .channel-label {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    color: var(--color-text-muted);
    font-weight: var(--font-weight-bold);
  }

  .channel-main-link {
    font-family: var(--font-display);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-snug);
    color: var(--color-text-primary);
    border-radius: var(--radius-xs);
    display: inline-block;
    overflow-wrap: anywhere;
    transition: color var(--transition-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .channel-main-link:hover {
      color: var(--accent-indigo-light);
    }
  }

  .channel-main-link:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  .channel-note {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .channel-note code {
    background: rgba(0, 0, 0, 0.4);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-xs);
    color: var(--color-text-secondary);
  }

  .channel-action {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .copy-email-btn {
    min-height: var(--target-min-size);
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-glass);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast), transform var(--transition-instant);
  }

  @media (hover: hover) and (pointer: fine) {
    .copy-email-btn:hover {
      background: rgba(255, 255, 255, 0.1);
      color: var(--color-text-primary);
    }
  }

  .copy-email-btn:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  .copy-email-btn:active {
    transform: scale(0.97);
  }

  .copy-email-btn.copied {
    background: var(--state-success-bg);
    border-color: var(--state-success-border);
    color: var(--state-success-text);
  }

  .copy-email-btn.is-error {
    background: var(--state-error-bg);
    border-color: var(--state-error-border);
    color: var(--state-error-text);
  }

  /* Secondary Channels */
  .secondary-channels {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .secondary-channels {
      grid-template-columns: 1fr 1fr;
    }
  }

  .sub-channel-card {
    padding: var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-md);
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-base);
  }

  @media (hover: hover) and (pointer: fine) {
    .sub-channel-card:hover {
      transform: translateY(-2px);
      border-color: var(--border-glass-hover);
    }
  }

  .sub-info {
    min-width: 0;
  }

  .sub-desc {
    overflow-wrap: anywhere;
  }

  .sub-channel-card:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  .sub-icon {
    width: var(--target-min-size);
    height: var(--target-min-size);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    flex-shrink: 0;
  }

  .sub-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .sub-title {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .sub-desc {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  /* Inquiry Info Box */
  .inquiry-info-box {
    width: 100%;
    padding: var(--space-xl);
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .info-title {
    font-size: var(--font-size-2xl);
  }

  .info-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 768px) {
    .info-columns {
      grid-template-columns: 1fr 1fr;
    }
  }

  .info-col {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .info-col strong {
    color: var(--color-text-primary);
  }
</style>
