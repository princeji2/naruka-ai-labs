---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Page Not Found (404)"
  description="The page you requested could not be found. Return to Naruka AI Labs."
>
  <div class="error-page section">
    <div class="container error-container">
      <Badge variant="demo-data" text="Error 404" />
      <h1 class="error-title">Page not found</h1>
      <p class="error-lead">
        The route you are trying to access does not exist on this site. If you were looking for our active product architectures or studio background, explore the links below.
      </p>

      <div class="error-actions">
        <Button href="/" variant="primary" size="lg">
          Return to Home
        </Button>
        <Button href="/products" variant="secondary" size="lg">
          Explore Products
        </Button>
      </div>

      <div class="error-hint-card glass-panel">
        <span class="hint-title">Looking for the Field Book application?</span>
        <p class="hint-text">
          The interactive campus ledger prototype is accessible at <a href="https://fieldbook.orgs.social" target="_blank" rel="noopener noreferrer">fieldbook.orgs.social ↗</a>.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page {
    min-height: calc(75vh - 72px);
    display: flex;
    align-items: center;
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-4xl);
  }

  .error-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 680px;
    gap: var(--space-md);
  }

  .error-title {
    font-size: var(--font-size-6xl);
    font-weight: var(--font-weight-extrabold);
    line-height: var(--line-height-tight);
  }

  .error-lead {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-lg);
  }

  .error-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: var(--space-2xl);
  }

  .error-hint-card {
    padding: var(--space-md) var(--space-lg);
    background: rgba(14, 18, 27, 0.6);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-sm);
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    width: 100%;
    max-width: 520px;
  }

  .hint-title {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .hint-text {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .hint-text a {
    color: var(--accent-indigo-light);
    text-decoration: underline;
    border-radius: var(--radius-xs);
  }

  .hint-text a:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }
</style>
