---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import Card from '../components/ui/Card.astro';
---

<BaseLayout
  title="Page Not Found (404)"
  description="The page you requested could not be found. Return to Naruka AI Labs."
>
  <div class="error-page section">
    <div class="container error-container">
      <!-- Intro block: badge, title, lead and actions. The only reveal hook on the page; the
           hint card animates on its own through the global .card reveal selector, so data-reveal
           is kept off it to avoid nesting a reveal hook inside a .card. -->
      <div class="error-intro" data-reveal>
        <Badge variant="demo-data" text="Error 404" />
        <h1 class="error-title">Page not found</h1>
        <p class="error-lead">
          The route you are trying to access does not exist on this site. If you were looking for our active product architectures or studio background, explore the links below.
        </p>

        <div class="error-actions">
          <Button href="/" variant="primary" size="lg">
            Return to Home
          </Button>
          <Button href="/products" variant="secondary" size="lg">
            Explore Products
          </Button>
        </div>
      </div>

      <div class="error-hint">
        <Card class="card-compact" headingLevel={2} title="Looking for the Field Book application?" gradient="secondary">
          <p class="hint-text">
            The interactive campus ledger prototype is accessible at <a href="https://fieldbook.orgs.social" target="_blank" rel="noopener noreferrer">fieldbook.orgs.social ↗</a>.
          </p>
        </Card>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page {
    min-height: calc(75vh - 72px);
    display: flex;
    align-items: center;
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-4xl);
  }

  .error-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 680px;
    gap: var(--space-xl);
  }

  /* Intro block: badge, title, lead and actions share one reveal hook. */
  .error-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    width: 100%;
  }

  .error-title {
    font-size: var(--font-size-display-2);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-display-2);
    letter-spacing: var(--letter-spacing-display-2);
    text-wrap: balance;
    max-width: 22ch;
  }

  .error-lead {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 60ch;
    line-height: 1.6;
  }

  .error-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-sm);
  }

  .error-hint {
    width: 100%;
    max-width: 520px;
    text-align: left;
  }

  .hint-text {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .hint-text a {
    color: var(--accent-indigo-light);
    text-decoration: underline;
    border-radius: var(--radius-xs);
  }

  .hint-text a:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }
</style>
