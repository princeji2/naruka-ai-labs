---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/ui/Card.astro';
---

<BaseLayout
  title="About Studio"
  description="About Naruka AI Labs: An independent, founder-led AI product studio building practical software products. Our mission, principles, and story."
  canonicalPath="/about"
>
  <div class="about-page">
    <!-- Header -->
    <section class="section about-hero-section">
      <div class="container hero-content">
        <Badge variant="in-development" text="Studio Background" />
        <h1 class="about-title">
          Engineering practical software <br />
          with <span class="text-gradient-brand">transparent principles</span>.
        </h1>
        <p class="about-lead">
          Naruka AI Labs is an independent, founder-led software studio founded by Prince Naruka. We build focused digital products that remove operational friction across public services, events, and developer workflows.
        </p>
      </div>
    </section>

    <!-- Mission & Origin Story -->
    <section class="section narrative-section">
      <div class="container story-grid">
        <Card
          headingLevel={2}
          title="Our Story"
          description="Naruka AI Labs started with a pragmatic premise: software products should solve concrete, daily problems."
          gradient="primary"
        >
          <div class="story-copy">
            <p class="story-p">
              Founder Prince Naruka began by building targeted technical prototypes—most notably participating in the Smart India Hackathon under problem statement SIH 26129. That project demonstrated how a single interoperability gateway could prevent citizens from repeatedly submitting duplicate documents across government departments.
            </p>
            <p class="story-p">
              Recognizing the broader need for unbloated, high-craft digital utilities, Naruka AI Labs was established to continue refining Setu and build new systems like Field Book (a campus event attendance and certification engine).
            </p>
          </div>
        </Card>

        <Card
          headingLevel={2}
          title="What We Are & What We Aren't"
          gradient="secondary"
        >
          <div class="contrast-stack">
            <div class="contrast-item is-yes">
              <span class="contrast-pill">WHAT WE ARE</span>
              <ul class="contrast-list">
                <li>An independent, founder-led product studio.</li>
                <li>Engineers who write typed, tested, maintainable code.</li>
                <li>Builders of real working prototypes (Setu gateway, Field Book ledger).</li>
                <li>Applying modern LLMs with strict, factual system guardrails.</li>
              </ul>
            </div>

            <div class="contrast-item is-no">
              <span class="contrast-pill">WHAT WE ARE NOT</span>
              <ul class="contrast-list">
                <li>Not a venture-backed corporation claiming artificial traction numbers.</li>
                <li>Not claiming official government affiliation or live Aadhaar access.</li>
                <li>Not claiming unearned partnerships or corporate endorsements.</li>
                <li>Not an agency building disposable marketing demos.</li>
              </ul>
            </div>
          </div>
        </Card>
      </div>
    </section>

    <!-- Operating Principles -->
    <section class="section principles-section">
      <div class="container">
        <div class="section-heading">
          <Badge variant="neutral" text="Our Operating Standards" />
          <h2 class="section-title">Core Principles</h2>
          <p class="section-lead">
            The engineering guidelines that govern every product we release.
          </p>
        </div>

        <div class="values-grid">
          <Card
            title="1. Code Over Claims"
            description="We prove functionality through running code, automated tests, and reproducible builds. If a feature is a prototype with simulated data, we state it unequivocally."
            gradient="primary"
          />
          <Card
            title="2. Architectural Restraint"
            description="We avoid heavy frameworks where plain standards excel. This website runs on static Astro with vanilla CSS tokens; our backends use PostgreSQL Row-Level Security for bulletproof isolation."
            gradient="secondary"
          />
          <Card
            title="3. Grounded Intelligence"
            description="We apply frontier AI models and verified LLM APIs for high-leverage engineering tasks and domain-bounded user assistants, never allowing models to invent ungrounded assertions."
            gradient="accent"
          />
          <Card
            title="4. Founder Accountability"
            description="Every repository commit, system architecture, and technical inquiry is personally reviewed and owned by founder Prince Naruka."
            gradient="neutral"
          />
        </div>
      </div>
    </section>

    <!-- Founder Spotlight -->
    <section class="section founder-profile-section">
      <div class="container">
        <Card
          class="card-wide"
          title="Prince Naruka"
          tagline="Founder, Full-Stack Engineer & Product Designer"
          description="Based in India · Active Builder"
          gradient="primary"
        >
          <div class="profile-body">
            <div class="profile-avatar" aria-hidden="true">PN</div>

            <div class="profile-right">
              <p class="profile-text">
                "My objective with Naruka AI Labs is to build software products that feel crisp, run fast, and solve real administrative problems. We treat engineering craft as our primary differentiator."
              </p>
              <div class="profile-links">
                <Button href="https://www.linkedin.com/in/prince-naruka-26581236b/" variant="secondary" size="sm" external={true}>
                  LinkedIn Profile ↗
                </Button>
                <Button href="https://github.com/princeji2" variant="secondary" size="sm" external={true}>
                  GitHub Profile ↗
                </Button>
                <Button href="mailto:naruka@orgs.social" variant="primary" size="sm">
                  naruka@orgs.social
                </Button>
              </div>
            </div>
          </div>
        </Card>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding-bottom: var(--space-4xl);
  }

  .about-hero-section {
    text-align: center;
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-2xl);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    max-width: 840px;
  }

  .about-title {
    font-size: var(--font-size-6xl);
    line-height: 1.15;
  }

  .about-lead {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 720px;
    line-height: var(--line-height-relaxed);
  }

  /* Story Grid */
  .narrative-section {
    padding-top: var(--space-md);
    padding-bottom: var(--space-3xl);
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 860px) {
    .story-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .story-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .story-p {
    font-size: var(--font-size-sm);
    color: color-mix(in srgb, var(--text) 78%, var(--text-muted));
    line-height: 1.6;
  }

  /* Contrast Box */
  .contrast-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contrast-item {
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .contrast-item.is-yes {
    background: rgba(var(--primary-rgb), 0.08);
    border: 1px solid var(--setu-emerald-border);
  }

  .contrast-item.is-no {
    background: rgba(var(--danger-rgb), 0.08);
    border: 1px solid var(--state-error-border);
  }

  .contrast-pill {
    font-size: var(--font-size-xs);
    font-family: var(--font-mono);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-wide);
  }

  .is-yes .contrast-pill {
    color: var(--setu-emerald-light);
  }

  .is-no .contrast-pill {
    color: var(--state-error-text);
  }

  .contrast-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .contrast-list li::before {
    content: '• ';
    color: var(--color-text-muted);
  }

  /* Principles */
  .section-heading {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-3xl);
  }

  .section-title {
    font-size: var(--font-size-5xl);
  }

  .section-lead {
    max-width: 680px;
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 768px) {
    .values-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Founder Profile (slot content) */
  .profile-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-top: var(--space-sm);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-subtle);
  }

  @media (min-width: 700px) {
    .profile-body {
      flex-direction: row;
      align-items: center;
    }
  }

  .profile-avatar {
    width: var(--space-9);
    height: var(--space-9);
    border-radius: var(--radius-full);
    background: var(--grad-studio-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: var(--font-weight-extrabold);
    font-size: var(--font-size-2xl);
    color: var(--on-brand);
    flex-shrink: 0;
  }

  .profile-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 680px;
  }

  .profile-text {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    font-style: italic;
    line-height: var(--line-height-relaxed);
  }

  .profile-links {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
</style>
