---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Badge from '../../../components/Badge.astro';
import Button from '../../../components/Button.astro';
import Card from '../../../components/ui/Card.astro';
---

<BaseLayout
  title="Field Book — Campus Event Attendance & Certification"
  description="A multi-role campus event attendance and verified credentialing platform with QR check-in, automated PDF certificates, and 67 database RLS security policies."
  canonicalPath="/products/field-book"
>
  <article class="product-detail-page">
    <!-- Header -->
    <section class="section detail-hero-section">
      <div class="container hero-layout">
        <div class="hero-text-col">
          <div class="kicker-row">
            <a href="/products" class="breadcrumb-link">← All Products</a>
            <span class="sep">/</span>
            <Badge variant="live-prototype" text="Live Prototype" />
            <Badge variant="in-development" text="Active Development" />
          </div>

          <h1 class="detail-title">
            Structured campus attendance and <br />
            <span class="text-gradient-amber">verified credentialing</span>.
          </h1>

          <p class="detail-lead">
            Field Book provides universities, student clubs, and event organizers with a lightweight, multi-role ledger to track event attendance via QR scanning and issue verifiable PDF certificates without heavyweight LMS bloat.
          </p>

          <div class="live-deployment">
            <Card
              class="card-compact"
              headingLevel={2}
              title="Functional Prototype Deployed"
              description="Field Book is currently accessible as a functional prototype with live authentication, role switching, and certificate generation."
              gradient="accent"
            >
              <div class="deployment-actions">
                <Button href="https://fieldbook.orgs.social" variant="primary" size="sm" external={true}>
                  Launch Live Prototype ↗
                </Button>
                <span class="url-hint">fieldbook.orgs.social</span>
              </div>
            </Card>
          </div>

          <div class="detail-ctas">
            <Button href="#roles" variant="secondary" size="md">
              Role Workflows ↓
            </Button>
            <Button href="#security" variant="secondary" size="md">
              Security & RLS Architecture ↓
            </Button>
          </div>
        </div>

        <!-- Role Architecture Visual Preview -->
        <div class="hero-visual-col">
          <Card
            class="card-compact"
            headingLevel={2}
            title="THREE-TIER ROLE ENGINE"
            status="Role-Based Access Control"
            statusColor="primary"
            gradient="neutral"
          >
            <div class="roles-visual-stack">
              <!-- Student Role -->
              <div class="role-layer student-layer">
                <div class="role-layer-header">
                  <span class="role-pill">Student</span>
                  <span class="role-desc">Event Discovery & Check-in</span>
                </div>
                <div class="role-features-row">
                  <span>• Scan event QR code</span>
                  <span>• Instant duplicate check-in rejection</span>
                  <span>• On-demand PDF certificate generation</span>
                </div>
              </div>

              <!-- Organizer Role -->
              <div class="role-layer organizer-layer">
                <div class="role-layer-header">
                  <span class="role-pill">Organizer</span>
                  <span class="role-desc">Event Creation & Management</span>
                </div>
                <div class="role-features-row">
                  <span>• Submit events for administrative approval</span>
                  <span>• Display attendance QR check-in passes</span>
                  <span>• Real-time attendee roster inspection</span>
                </div>
              </div>

              <!-- Admin Role -->
              <div class="role-layer admin-layer">
                <div class="role-layer-header">
                  <span class="role-pill">Administrator</span>
                  <span class="role-desc">Governance & Security</span>
                </div>
                <div class="role-features-row">
                  <span>• Approve/reject event submissions</span>
                  <span>• Review role change requests</span>
                  <span>• Append-only audit log oversight</span>
                </div>
              </div>
            </div>

            <div class="preview-footer">
              <span>Security enforced via 67 Postgres Row-Level Security policies.</span>
            </div>
          </Card>
        </div>
      </div>
    </section>

    <!-- Key Workflow Features -->
    <section class="section workflow-section" id="roles">
      <div class="container">
        <div class="section-heading">
          <Badge variant="in-development" text="System Capabilities" />
          <h2 class="section-title">Core Platform Architecture</h2>
          <p class="section-lead">
            Designed to solve the administrative bottleneck of managing hundreds of event attendees while maintaining tamper-resistant credential integrity.
          </p>
        </div>

        <div class="workflow-grid">
          <!-- Feature 1: QR Attendance -->
          <Card
            title="Event-Code QR Attendance"
            description="Organizers project an active attendance QR code containing the structured event identifier. Students scan via the built-in browser scanner."
            status="01"
            gradient="primary"
          >
            <div class="workflow-callout">
              <strong>Duplicate Prevention:</strong> Enforced at the database layer via a compound unique constraint on <code>(student_id, event_id)</code>. Repeat scans are caught by Postgres (Error 23505) and rejected instantly.
            </div>
          </Card>

          <!-- Feature 2: PDF Certificate Engine -->
          <Card
            title="Automated PDF Certificate Generation"
            description="Once attendance is confirmed in the database, eligible students can trigger automated certificate compilation."
            status="02"
            gradient="secondary"
          >
            <div class="workflow-callout">
              <strong>Dedicated Microservice:</strong> Powered by a separate Java 17 / Spring Boot service utilizing Apache PDFBox 3 to dynamically composite student names, event metadata, and template background art into signed PDF documents.
            </div>
          </Card>

          <!-- Feature 3: Approval Pipeline -->
          <Card
            title="Two-Tier Event Approval Pipeline"
            description="Club organizers can draft and submit event proposals, but events do not enter public discovery until reviewed and approved by institution administrators."
            status="03"
            gradient="accent"
          >
            <div class="workflow-callout">
              <strong>Permission Guards:</strong> Role changes are submitted through formal review requests, ensuring student users cannot self-escalate to organizer or administrator privileges.
            </div>
          </Card>
        </div>
      </div>
    </section>

    <!-- Security & Audit Section -->
    <section class="section security-section" id="security">
      <div class="container">
        <Card
          class="card-wide"
          title="Technical Verification & Security Audit"
          description="Field Book delegates authorization entirely to the database tier rather than relying on frontend client-side validation alone."
          status="DATABASE-ENFORCED PERMISSIONS"
          statusColor="primary"
          gradient="primary"
        >
          <div class="security-stats-grid">
            <div class="sec-stat-item">
              <span class="sec-number">67</span>
              <span class="sec-label">Active RLS Policies</span>
              <span class="sec-sub">Enforced across profiles, events, approvals, certificates, and storage buckets</span>
            </div>

            <div class="sec-stat-item">
              <span class="sec-number">Append-Only</span>
              <span class="sec-label">Audit Trail Design</span>
              <span class="sec-sub">RLS permits INSERT and SELECT for administrators; zero UPDATE or DELETE policies exist for application roles</span>
            </div>

            <div class="sec-stat-item">
              <span class="sec-number">3-Tier</span>
              <span class="sec-label">Role Isolation</span>
              <span class="sec-sub">Role guards at route, RPC, and PostgreSQL table levels prevent privilege escalation</span>
            </div>
          </div>

          <div class="security-clarification">
            <p>
              <strong>Technical Disclosure:</strong> Attendance QR codes encode structured event tokens (<code>fieldbook:attendance:&lt;CODE&gt;</code>) rather than asymmetric cryptographic signatures; uniqueness and integrity are enforced by PostgreSQL relational constraints and authenticated session IDs. Audit logs are append-only at the application/RLS layer, preventing accidental or malicious modification through the web application.
            </p>
          </div>
        </Card>
      </div>
    </section>

    <!-- Tech Stack Summary -->
    <section class="section tech-summary-section">
      <div class="container">
        <Card
          class="card-wide"
          title="Field Book Production Stack"
          gradient="neutral"
        >
          <div class="table-grid">
            <div class="table-row header-row">
              <span>Layer</span>
              <span>Technology</span>
              <span>Role in Architecture</span>
            </div>
            <div class="table-row">
              <span class="row-layer">Frontend SPA</span>
              <span class="row-tech">React 18 · Vite · TypeScript · Tailwind CSS</span>
              <span class="row-desc">Client interface, QR camera capture, role dashboards</span>
            </div>
            <div class="table-row">
              <span class="row-layer">Database & Auth</span>
              <span class="row-tech">Supabase (PostgreSQL 15)</span>
              <span class="row-desc">Row-Level Security, Auth PKCE, Storage Buckets, Triggers</span>
            </div>
            <div class="table-row">
              <span class="row-layer">Certificate Service</span>
              <span class="row-tech">Java 17 · Spring Boot 4 · Apache PDFBox 3</span>
              <span class="row-desc">Server-side vector rendering of verified PDF certificates</span>
            </div>
            <div class="table-row">
              <span class="row-layer">Deployment</span>
              <span class="row-tech">Vercel (Frontend) · Docker / Render (Backend)</span>
              <span class="row-desc">High-availability static frontend and microservice host</span>
            </div>
          </div>
        </Card>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .product-detail-page {
    padding-bottom: var(--space-4xl);
  }

  .detail-hero-section {
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-3xl);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-layout {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-3xl);
    }
  }

  .hero-text-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .kicker-row {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin-bottom: var(--space-xs);
  }

  .breadcrumb-link {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    border-radius: var(--radius-xs);
  }

  .breadcrumb-link:hover {
    color: var(--color-text-primary);
  }

  .breadcrumb-link:focus-visible {
    outline: var(--state-focus-outline);
    outline-offset: var(--state-focus-ring-offset);
  }

  .sep {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .detail-title {
    font-size: var(--font-size-6xl);
    line-height: var(--line-height-tight);
  }

  .text-gradient-amber {
    background: linear-gradient(100deg, color-mix(in srgb, var(--fieldbook-amber-light) 60%, var(--text)) 0%, var(--fieldbook-amber-light) 45%, var(--fieldbook-amber) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .detail-lead {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  /* Live Deployment (slot content) */
  .live-deployment {
    margin-top: var(--space-xs);
  }

  .deployment-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    flex-wrap: wrap;
  }

  .url-hint {
    font-size: var(--font-size-xs);
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .detail-ctas {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: var(--space-sm);
  }

  /* Roles Preview (slot content) */
  .roles-visual-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }

  .role-layer {
    padding: var(--space-md);
    border-radius: var(--radius-sm);
    background: rgba(var(--white-rgb), 0.04);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .role-layer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .role-pill {
    font-size: var(--font-size-xs);
    font-weight: 700;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    text-transform: uppercase;
  }

  .student-layer .role-pill {
    background: rgba(var(--primary-rgb), 0.15);
    color: var(--accent-indigo-light);
  }

  .organizer-layer .role-pill {
    background: rgba(var(--accent-rgb), 0.15);
    color: var(--fieldbook-amber-light);
  }

  .admin-layer .role-pill {
    background: rgba(var(--secondary-rgb), 0.2);
    color: var(--color-text-primary);
  }

  .role-desc {
    font-size: var(--font-size-xs);
    color: var(--text-muted);
  }

  .role-features-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
  }

  .preview-footer {
    font-size: var(--font-size-xs);
    color: var(--text-muted);
    margin-top: var(--space-sm);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--border-subtle);
  }

  /* Workflow Grid */
  .section-heading {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xl);
  }

  .section-title {
    font-size: var(--font-size-5xl);
  }

  .section-lead {
    max-width: 680px;
    font-size: var(--font-size-md);
    color: var(--text-secondary);
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 900px) {
    .workflow-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .workflow-callout {
    margin-top: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: rgba(var(--black-rgb), 0.3);
    border-left: 2px solid var(--fieldbook-amber);
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    border-radius: 0 var(--radius-xs) var(--radius-xs) 0;
    line-height: 1.5;
  }

  .workflow-callout strong {
    color: var(--text-primary);
  }

  .workflow-callout code {
    background: rgba(var(--white-rgb), 0.08);
    padding: 1px 4px;
    border-radius: var(--radius-xs);
    color: var(--fieldbook-amber-light);
  }

  /* Security (slot content) */
  .security-stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  @media (min-width: 768px) {
    .security-stats-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .sec-stat-item {
    padding: var(--space-lg);
    background: rgba(var(--black-rgb), 0.3);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sec-number {
    font-family: var(--font-display);
    font-size: var(--font-size-4xl);
    font-weight: 800;
    color: var(--text-primary);
  }

  .sec-label {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--fieldbook-amber-light);
  }

  .sec-sub {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: 1.45;
    margin-top: 4px;
  }

  .security-clarification {
    margin-top: var(--space-lg);
    padding: var(--space-md);
    background: rgba(var(--white-rgb), 0.04);
    border-left: 2px solid var(--accent-indigo);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  .security-clarification strong {
    color: var(--text-primary);
  }

  .security-clarification code {
    background: rgba(var(--black-rgb), 0.35);
    padding: 1px 4px;
    border-radius: var(--radius-xs);
  }

  /* Tech Table (slot content) */
  .table-grid {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-top: var(--space-sm);
  }

  .table-row {
    display: grid;
    grid-template-columns: 1.2fr 1.5fr 2fr;
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--border-subtle);
    font-size: var(--font-size-sm);
    align-items: center;
  }

  .table-row:last-child {
    border-bottom: none;
  }

  .header-row {
    background: rgba(var(--white-rgb), 0.06);
    font-weight: 700;
    text-transform: uppercase;
    font-size: var(--font-size-xs);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .row-layer {
    font-weight: 600;
    color: var(--text-primary);
  }

  .row-tech {
    color: var(--fieldbook-amber-light);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }

  .row-desc {
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .table-row {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: var(--space-md);
    }
    .header-row {
      display: none;
    }
  }
</style>
