---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
---

<BaseLayout
  title="Products"
  description="Explore products built by Naruka AI Labs: Setu (public digital platform interoperability gateway) and Field Book (event attendance & certificate platform)."
  canonicalPath="/products"
>
  <div class="products-page">
    <!-- Header Section -->
    <section class="page-header section">
      <div class="container header-content">
        <Badge variant="in-development" text="Studio Portfolio" />
        <h1 class="page-title">
          Practical software, <br />
          <span class="text-gradient-brand">built for real workflows</span>.
        </h1>
        <p class="page-lead">
          We build focused products designed to eliminate administrative friction and fragmented data silos. Every product is developed iteratively with solid technical foundations.
        </p>
      </div>
    </section>

    <!-- Products Grid -->
    <section class="products-list-section">
      <div class="container products-grid">
        
        <!-- Product Card 1: Setu -->
        <article class="product-card glass-panel" id="setu-card">
          <div class="card-top">
            <div class="product-header">
              <div class="product-icon setu-icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 11a9 9 0 0 1 9 9"></path>
                  <path d="M4 4a16 16 0 0 1 16 16"></path>
                  <circle cx="5" cy="19" r="1"></circle>
                </svg>
              </div>
              <div class="product-titles">
                <div class="badge-row">
                  <Badge variant="in-development" text="In Active Development" />
                  <Badge variant="demo-data" text="Simulated Backends" />
                </div>
                <h2 class="product-name">Setu</h2>
                <span class="product-category">Consent-Based Interoperability Gateway</span>
              </div>
            </div>
            
            <p class="product-desc">
              A unified citizen gateway that links public service portals behind a single citizen login, allowing verified records to be shared with consent instead of repeatedly re-uploaded.
            </p>

            <div class="product-specs">
              <div class="spec-item">
                <span class="spec-label">Origins</span>
                <span class="spec-value">Smart India Hackathon (SIH 26129)</span>
              </div>
              <div class="spec-item">
                <span class="spec-label">Core Paradigm</span>
                <span class="spec-value">"Verified once, shared with consent — not copied"</span>
              </div>
              <div class="spec-item">
                <span class="spec-label">Architecture</span>
                <span class="spec-value">Node.js Express Gateway · PostgreSQL · Gemini Service Proxy</span>
              </div>
            </div>

            <!-- Simulation Notice -->
            <div class="card-notice">
              <strong>Heritage Note:</strong> Originated as an SIH hackathon prototype. Integrates with independently deployed mock microservices with synthetic demo data. Does not connect to live government infrastructure.
            </div>
          </div>

          <div class="card-actions">
            <Button href="/products/setu" variant="primary" size="md">
              Read Setu Architecture →
            </Button>
            <Button href="https://github.com/princeji2/naruka-ai-labs" variant="secondary" size="md" external={true}>
              Repository Info
            </Button>
          </div>
        </article>

        <!-- Product Card 2: Field Book -->
        <article class="product-card glass-panel" id="fieldbook-card">
          <div class="card-top">
            <div class="product-header">
              <div class="product-icon fieldbook-icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
              </div>
              <div class="product-titles">
                <div class="badge-row">
                  <Badge variant="live-prototype" text="Live Prototype" />
                  <Badge variant="in-development" text="Active Development" />
                </div>
                <h2 class="product-name">Field Book</h2>
                <span class="product-category">Campus Attendance & Credentialing Ledger</span>
              </div>
            </div>
            
            <p class="product-desc">
              A lightweight, multi-role event attendance and verified credentialing platform featuring QR attendance check-ins, automated server-rendered PDF certificates, and database-enforced security.
            </p>

            <div class="product-specs">
              <div class="spec-item">
                <span class="spec-label">Roles Supported</span>
                <span class="spec-value">Student, Organizer, Administrator (Dedicated Views)</span>
              </div>
              <div class="spec-item">
                <span class="spec-label">Security Layer</span>
                <span class="spec-value">67 Database Row-Level Security (RLS) Policies</span>
              </div>
              <div class="spec-item">
                <span class="spec-label">Certificate Engine</span>
                <span class="spec-value">Java 17 / Spring Boot 4 + Apache PDFBox 3</span>
              </div>
            </div>

            <!-- Functional Status Notice -->
            <div class="card-notice">
              <strong>Prototype Deployment:</strong> Built for institutional & club events. Available as a working functional prototype with real Supabase authentication and certificate generation.
            </div>
          </div>

          <div class="card-actions">
            <Button href="/products/field-book" variant="primary" size="md">
              Explore Field Book Details →
            </Button>
            <Button href="https://fieldbook.orgs.social" variant="secondary" size="md" external={true}>
              Open Live Prototype ↗
            </Button>
          </div>
        </article>

      </div>
    </section>

    <!-- Studio Explorations Section -->
    <section class="section r-and-d-section">
      <div class="container">
        <div class="r-and-d-box glass-panel">
          <div class="r-and-d-content">
            <Badge variant="planned" text="R&D Initiatives" />
            <h3 class="r-and-d-title">Exploratory AI & Assistant Tooling</h3>
            <p class="r-and-d-text">
              In addition to our core products, Naruka AI Labs conducts early exploratory research on domain-grounded conversational assistants and contextual edge intelligence. These initiatives remain in the prototype and research phase, guided by developer experimentation and practical applicability.
            </p>
          </div>
          <div class="r-and-d-cta">
            <Button href="/about" variant="secondary" size="md">
              Our Studio Philosophy →
            </Button>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .products-page {
    padding-bottom: var(--space-4xl);
  }

  .page-header {
    text-align: center;
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-2xl);
  }

  .header-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    max-width: 820px;
  }

  .page-lead {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
    max-width: 680px;
  }

  .products-list-section {
    padding-top: var(--space-md);
    padding-bottom: var(--space-3xl);
  }

  .products-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 900px) {
    .products-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .product-card {
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xl);
    position: relative;
    overflow: hidden;
  }

  .card-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .product-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .product-icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .setu-icon {
    background: rgba(16, 185, 129, 0.12);
    color: var(--setu-emerald-light);
    border: 1px solid var(--setu-emerald-border);
  }

  .fieldbook-icon {
    background: rgba(245, 158, 11, 0.12);
    color: var(--fieldbook-amber-light);
    border: 1px solid var(--fieldbook-amber-border);
  }

  .product-titles {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .badge-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 2px;
  }

  .product-name {
    font-size: var(--font-size-4xl);
    font-weight: 700;
  }

  .product-category {
    font-size: var(--font-size-sm);
    color: var(--text-muted);
    font-weight: 500;
  }

  .product-desc {
    font-size: var(--font-size-md);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .product-specs {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  @media (min-width: 500px) {
    .spec-item {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
    }
  }

  .spec-label {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .spec-value {
    font-size: var(--font-size-sm);
    color: var(--text-primary);
    font-weight: 500;
    text-align: right;
  }

  .card-notice {
    padding: var(--space-sm) var(--space-md);
    background: rgba(255, 255, 255, 0.02);
    border-left: 2px solid var(--border-glass-hover);
    font-size: var(--font-size-xs);
    line-height: 1.5;
    color: var(--text-muted);
    border-radius: 0 var(--radius-xs) var(--radius-xs) 0;
  }

  .card-notice strong {
    color: var(--text-secondary);
  }

  .card-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-subtle);
  }

  /* R&D Section */
  .r-and-d-section {
    padding-top: 0;
  }

  .r-and-d-box {
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl));
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    background: rgba(14, 18, 27, 0.5);
  }

  @media (min-width: 800px) {
    .r-and-d-box {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .r-and-d-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-width: 760px;
  }

  .r-and-d-title {
    font-size: var(--font-size-2xl);
    margin-top: 4px;
  }

  .r-and-d-text {
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
  }

  .r-and-d-cta {
    flex-shrink: 0;
  }
</style>
