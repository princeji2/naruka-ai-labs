---
/**
 * /signin: visual copy of refrence/signin.txt (sliding-panel Sign in / Sign up card).
 *
 * PLACEHOLDER PAGE. There is no authentication here:
 *   - both forms are inert (submit is cancelled in the script, no network request is made)
 *   - fields have an empty `name`, so even with JavaScript off nothing is added to the URL
 *   - the page is noindex and is NOT linked from the navbar, footer or any other page,
 *     and it is NOT listed in sitemap.xml.ts
 *
 * Colours come from tokens only. The reference's purple gradient and white card are
 * mapped to the site palette (primary -> accent gradient on a dark glass card).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/Button.astro';

// Social icons from the reference, drawn in one colour (currentColor) so no brand hex is needed.
// The buttons are disabled: they are a visual placeholder only.
const socials = [
  {
    name: 'Google',
    paths: [
      'M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z',
      'M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z',
      'M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z',
      'M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z',
    ],
  },
  {
    name: 'Facebook',
    paths: [
      'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
    ],
  },
  {
    name: 'Twitter',
    paths: [
      'M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z',
    ],
  },
  {
    name: 'LinkedIn',
    paths: [
      'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
    ],
  },
];
---

<BaseLayout
  title="Sign in"
  description="Sign in or sign up to Naruka AI Labs. Placeholder page, not yet available."
  canonicalPath="/signin"
  noindex
>
  <div class="auth-page">
    <h1 class="sr-only">Sign in or sign up (placeholder, accounts are not available yet)</h1>

    <!-- Announces mode changes to screen readers -->
    <p class="sr-only" id="auth-live" role="status" aria-live="polite"></p>

    <div class="auth" id="auth">
      <div class="forms-container">
        <div class="signin-signup">
          <!-- SIGN IN -->
          <form class="sign-in-form" id="form-signin" aria-labelledby="title-signin" novalidate>
            <h2 class="title" id="title-signin" tabindex="-1">Sign in</h2>
            <div class="fields">
              <Input id="si-email" name="" label="Email" type="email" placeholder="Email" autocomplete="email" required />
              <Input id="si-password" name="" label="Password" type="password" placeholder="Password" autocomplete="current-password" required />
            </div>
            <Button type="submit" variant="primary" size="md" class="submit-btn">Login</Button>
            <p class="form-note" data-form-note></p>
            <p class="social-text">Or sign in with social platforms</p>
            <div class="social-media" role="group" aria-label="Social sign-in, not available yet">
              {socials.map((social) => (
                <Button variant="secondary" size="icon" disabled aria-label={`${social.name} sign-in (not available yet)`} class="social-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    {social.paths.map((d) => <path d={d} />)}
                  </svg>
                </Button>
              ))}
            </div>

            {/*
              FUTURE: Field Book login link.
              When Field Book sign-in is ready, render the link inside the div below, for example:
                <a href="https://fieldbook.orgs.social" class="fieldbook-link">Sign in to Field Book</a>
              The div is hidden while it is empty, so nothing shows until then.
            */}
            <div class="fieldbook-slot" data-slot="fieldbook-login"></div>
          </form>

          <!-- SIGN UP (inert until the toggle shows it) -->
          <form class="sign-up-form" id="form-signup" aria-labelledby="title-signup" novalidate inert>
            <h2 class="title" id="title-signup" tabindex="-1">Sign up</h2>
            <div class="fields">
              <Input id="su-username" name="" label="Username" type="text" placeholder="Username" autocomplete="username" required />
              <Input id="su-email" name="" label="Email" type="email" placeholder="Email" autocomplete="email" required />
              <Input id="su-password" name="" label="Password" type="password" placeholder="Password" autocomplete="new-password" required />
            </div>
            <Button type="submit" variant="primary" size="md" class="submit-btn">Sign up</Button>
            <p class="form-note" data-form-note></p>
            <p class="social-text">Or sign up with social platforms</p>
            <div class="social-media" role="group" aria-label="Social sign-up, not available yet">
              {socials.map((social) => (
                <Button variant="secondary" size="icon" disabled aria-label={`${social.name} sign-up (not available yet)`} class="social-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    {social.paths.map((d) => <path d={d} />)}
                  </svg>
                </Button>
              ))}
            </div>
          </form>
        </div>
      </div>

      <div class="panels-container">
        <div class="panel left-panel" id="panel-signup">
          <div class="content">
            <h3 class="panel-title">New here?</h3>
            <p>Join us today and discover a world of possibilities. Create your account in seconds!</p>
            <Button type="button" variant="ghost" size="sm" class="panel-btn" id="show-signup" aria-controls="form-signup">Sign up</Button>
          </div>
        </div>

        <div class="panel right-panel" id="panel-signin" inert>
          <div class="content">
            <h3 class="panel-title">One of us?</h3>
            <p>Welcome back! Sign in to continue your journey with us.</p>
            <Button type="button" variant="ghost" size="sm" class="panel-btn" id="show-signin" aria-controls="form-signin">Sign in</Button>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Vanilla JS. No network requests, no storage, no auth: the forms are inert.
  function byId<T extends HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error(`#${id} is missing`);
    return el as T;
  }

  const auth = byId<HTMLDivElement>('auth');
  const live = byId<HTMLParagraphElement>('auth-live');
  const signInForm = byId<HTMLFormElement>('form-signin');
  const signUpForm = byId<HTMLFormElement>('form-signup');
  const signUpPanel = byId<HTMLDivElement>('panel-signup'); // left panel: "New here?" + Sign up button
  const signInPanel = byId<HTMLDivElement>('panel-signin'); // right panel: "One of us?" + Sign in button
  const signInTitle = byId<HTMLHeadingElement>('title-signin');
  const signUpTitle = byId<HTMLHeadingElement>('title-signup');

  // Only the visible form and its matching panel can be reached by keyboard or screen reader.
  function setMode(signUp: boolean, moveFocus: boolean): void {
    auth.classList.toggle('sign-up-mode', signUp);
    signInForm.inert = signUp;
    signUpForm.inert = !signUp;
    signUpPanel.inert = signUp;
    signInPanel.inert = !signUp;

    live.textContent = signUp ? 'Sign up form shown.' : 'Sign in form shown.';

    // The button that was just pressed becomes inert, so move focus to the new form heading.
    if (moveFocus) (signUp ? signUpTitle : signInTitle).focus({ preventScroll: true });
  }

  byId<HTMLButtonElement>('show-signup').addEventListener('click', () => setMode(true, true));
  byId<HTMLButtonElement>('show-signin').addEventListener('click', () => setMode(false, true));

  // Inert submit: cancel it and say so. Nothing is sent anywhere.
  for (const form of [signInForm, signUpForm]) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const note = form.querySelector<HTMLElement>('[data-form-note]');
      if (note) note.textContent = 'This is a placeholder. Sign in and sign up are not available yet.';
    });
  }
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .auth-page {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(var(--space-7), 6vw, var(--space-9)) var(--space-5);
  }

  /* ---------------- Card (reference: .container, 900 x 550) ---------------- */
  .auth {
    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: 900px;
    height: 620px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-glass);
    background: var(--grad-surface-card);
    backdrop-filter: blur(var(--glass-blur-md));
    -webkit-backdrop-filter: blur(var(--glass-blur-md));
    box-shadow: var(--shadow-card);
  }

  /* The big circle that slides between the two halves */
  .auth::before {
    content: '';
    position: absolute;
    height: 2000px;
    width: 2000px;
    top: -10%;
    right: 48%;
    transform: translateY(-50%);
    background: linear-gradient(-45deg, var(--primary) 0%, var(--accent) 100%);
    transition: 1.8s ease-in-out;
    border-radius: 50%;
    z-index: 6;
  }

  .forms-container {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
  }

  .signin-signup {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    left: 75%;
    width: 50%;
    transition: 1s 0.7s ease-in-out;
    display: grid;
    grid-template-columns: 1fr;
    z-index: 5;
  }

  form {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: var(--space-4);
    padding: 0 var(--space-8);
    transition: all 0.2s 0.7s;
    grid-column: 1 / 2;
    grid-row: 1 / 2;
  }

  form.sign-up-form {
    opacity: 0;
    z-index: 1;
  }

  form.sign-in-form {
    z-index: 2;
  }

  .title {
    font-size: var(--font-size-4xl);
    line-height: var(--line-height-snug);
    color: var(--text);
  }

  /* Heading receives focus after a toggle; it is not interactive, so no ring */
  .title:focus {
    outline: none;
  }

  .fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    max-width: 380px;
  }

  .submit-btn {
    min-width: 150px;
    margin-top: var(--space-2);
  }

  /* Message shown after an (inert) submit; takes no space while empty */
  .form-note {
    max-width: 380px;
    text-align: center;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-snug);
    color: var(--state-success-text);
  }

  .form-note:empty {
    display: none;
  }

  .social-text {
    font-size: var(--font-size-sm);
    color: var(--text-muted);
    text-align: center;
  }

  .social-media {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  .social-media :global(.social-icon) {
    border-radius: var(--radius-full);
    color: var(--accent);
  }

  .fieldbook-slot:empty {
    display: none;
  }

  /* ---------------- Panels ---------------- */
  .panels-container {
    position: absolute;
    height: 100%;
    width: 100%;
    top: 0;
    left: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    /* Only the active panel takes pointer events, so the forms underneath stay clickable */
    pointer-events: none;
  }

  .panel {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-around;
    text-align: center;
    z-index: 6;
  }

  .left-panel {
    pointer-events: all;
    padding: var(--space-8) 17% var(--space-7) 12%;
  }

  .right-panel {
    pointer-events: none;
    padding: var(--space-8) 12% var(--space-7) 17%;
  }

  /* Text sits on the primary-to-accent gradient: --on-brand is >= 5.5:1 on both ends */
  .panel .content {
    color: var(--on-brand);
    transition: transform 0.9s ease-in-out;
    transition-delay: 0.6s;
  }

  .panel-title {
    color: inherit;
    font-size: var(--font-size-3xl);
    line-height: 1;
    margin-bottom: var(--space-3);
  }

  .panel p {
    color: inherit;
    font-size: var(--font-size-sm);
    padding: var(--space-3) 0;
  }

  /* Outlined button on the coloured circle */
  .panel :global(.panel-btn) {
    color: var(--on-brand);
    background: transparent;
    border: 2px solid var(--on-brand);
    font-weight: var(--font-weight-semibold);
  }

  @media (hover: hover) and (pointer: fine) {
    .panel :global(.panel-btn:hover) {
      color: var(--on-brand);
      background: rgba(var(--bg-rgb), 0.12);
    }
  }

  .panel :global(.panel-btn:focus-visible) {
    outline-color: var(--on-brand);
  }

  .right-panel .content {
    transform: translateX(800px);
  }

  /* ---------------- Sign-up mode ---------------- */
  .auth.sign-up-mode::before {
    transform: translate(100%, -50%);
    right: 52%;
  }

  .auth.sign-up-mode .left-panel .content {
    transform: translateX(-800px);
  }

  .auth.sign-up-mode .signin-signup {
    left: 25%;
  }

  .auth.sign-up-mode form.sign-up-form {
    opacity: 1;
    z-index: 2;
  }

  .auth.sign-up-mode form.sign-in-form {
    opacity: 0;
    z-index: 1;
  }

  .auth.sign-up-mode .right-panel .content {
    transform: translateX(0%);
  }

  .auth.sign-up-mode .left-panel {
    pointer-events: none;
  }

  .auth.sign-up-mode .right-panel {
    pointer-events: all;
  }

  /* ---------------- Tablet and phone ---------------- */
  @media (max-width: 870px) {
    .auth {
      height: 820px;
    }

    .signin-signup {
      width: 100%;
      top: 95%;
      transform: translate(-50%, -100%);
      transition: 1s 0.8s ease-in-out;
    }

    .signin-signup,
    .auth.sign-up-mode .signin-signup {
      left: 50%;
    }

    .panels-container {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 2fr 1fr;
    }

    .panel {
      flex-direction: row;
      justify-content: space-around;
      align-items: center;
      padding: var(--space-5) 8%;
      grid-column: 1 / 2;
    }

    .right-panel {
      grid-row: 3 / 4;
    }

    .left-panel {
      grid-row: 1 / 2;
    }

    .panel .content {
      padding-right: 15%;
      transition: transform 0.9s ease-in-out;
      transition-delay: 0.8s;
    }

    .panel-title {
      font-size: var(--font-size-lg);
    }

    .panel p {
      font-size: var(--font-size-xs);
      padding: var(--space-3) 0;
    }

    .auth::before {
      width: 1500px;
      height: 1500px;
      transform: translateX(-50%);
      left: 30%;
      bottom: 68%;
      right: initial;
      top: initial;
      transition: 2s ease-in-out;
    }

    .auth.sign-up-mode::before {
      transform: translate(-50%, 100%);
      bottom: 32%;
      right: initial;
    }

    .auth.sign-up-mode .left-panel .content {
      transform: translateY(-300px);
    }

    .auth.sign-up-mode .right-panel .content {
      transform: translateY(0px);
    }

    .right-panel .content {
      transform: translateY(300px);
    }

    .auth.sign-up-mode .signin-signup {
      top: 5%;
      transform: translate(-50%, 0);
    }
  }

  @media (max-width: 570px) {
    form {
      padding: 0 var(--space-5);
    }

    .panel .content {
      padding: var(--space-3) var(--space-5);
    }
  }

  /* ---------------- Preferences ---------------- */
  /* No sliding: the swap is instant. Delays are removed too, or the swap would wait 0.7s. */
  @media (prefers-reduced-motion: reduce) {
    .auth::before,
    .signin-signup,
    form,
    .panel .content {
      transition: none;
      transition-delay: 0s;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .auth {
      background: var(--color-surface-card);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
