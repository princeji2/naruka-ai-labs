---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Naruka AI Labs — Practical AI Product Studio"
  description="Naruka AI Labs builds practical AI-powered software products. Independent, founder-led studio and creators of Setu and Field Book."
  canonicalPath="/"
>
  <!-- 1. Hero Section -->
  <section class="hero-section section">
    <div class="container hero-container">
      <div class="hero-badge-wrap">
        <Badge variant="in-development" text="Founder-Led Product Studio" />
        <span class="location-tag">Based in India · Building Globally</span>
      </div>

      <h1 class="hero-title">
        Naruka AI Labs builds <br />
        <span class="text-gradient-brand">practical AI-powered software</span> products.
      </h1>

      <p class="hero-lead">
        An independent studio founded by Prince Naruka. We turn complex administrative and educational friction into fast, reliable software with clean architectures and grounded intelligence.
      </p>

      <div class="hero-actions">
        <Button href="/products" variant="primary" size="lg">
          Explore Products →
        </Button>
        <Button href="/about" variant="secondary" size="lg">
          Our Story & Principles
        </Button>
      </div>
    </div>
  </section>

  <!-- 2. What We're Building (Products Spotlight Grid) -->
  <section class="section showcase-section" id="products">
    <div class="container">
      <div class="section-heading">
        <Badge variant="in-development" text="Active Portfolio" />
        <h2 class="section-title">What We're Building</h2>
        <p class="section-lead">
          Two focused software products tackling fragmented administrative data and chaotic event credentials.
        </p>
      </div>

      <div class="showcase-grid">
        <!-- Spotlight Card: Setu -->
        <article class="showcase-card glass-panel setu-spotlight">
          <div class="showcase-card-inner">
            <div class="card-badge-row">
              <Badge variant="in-development" text="In Active Development" />
              <Badge variant="demo-data" text="Simulated Backends" />
            </div>

            <h3 class="card-product-title">Setu</h3>
            <p class="card-tagline">Citizen-Centric Interoperability Gateway</p>

            <p class="card-product-desc">
              Connects isolated public service portals behind a single citizen login, allowing verified records to be relayed with explicit consent rather than repeatedly re-uploaded and stored across multiple silos.
            </p>

            <div class="card-facts-list">
              <div class="fact-row">
                <span class="fact-k">Origin:</span>
                <span class="fact-v">Smart India Hackathon (SIH 26129 prototype)</span>
              </div>
              <div class="fact-row">
                <span class="fact-k">Paradigm:</span>
                <span class="fact-v">"Verified once, shared with consent — not copied"</span>
              </div>
              <div class="fact-row">
                <span class="fact-k">Environment:</span>
                <span class="fact-v">Relays to 3 isolated mock microservices with synthetic records</span>
              </div>
            </div>

            <div class="card-action-bar">
              <Button href="/products/setu" variant="primary" size="md">
                Setu Architecture & Details →
              </Button>
            </div>
          </div>
        </article>

        <!-- Spotlight Card: Field Book -->
        <article class="showcase-card glass-panel fieldbook-spotlight">
          <div class="showcase-card-inner">
            <div class="card-badge-row">
              <Badge variant="live-prototype" text="Live Prototype" />
              <Badge variant="in-development" text="Active Development" />
            </div>

            <h3 class="card-product-title">Field Book</h3>
            <p class="card-tagline">Campus Event Attendance & Credentialing Ledger</p>

            <p class="card-product-desc">
              A streamlined platform for university clubs and organizers to conduct event check-ins via QR codes and generate verified, server-rendered PDF certificates once attendance is recorded.
            </p>

            <div class="card-facts-list">
              <div class="fact-row">
                <span class="fact-k">Live Demo:</span>
                <span class="fact-v">field-book-delta.vercel.app</span>
              </div>
              <div class="fact-row">
                <span class="fact-k">Security:</span>
                <span class="fact-v">67 Postgres Row-Level Security (RLS) policies</span>
              </div>
              <div class="fact-row">
                <span class="fact-k">Engine:</span>
                <span class="fact-v">Java 17 Spring Boot + Apache PDFBox 3</span>
              </div>
            </div>

            <div class="card-action-bar">
              <Button href="/products/field-book" variant="primary" size="md">
                Field Book Architecture →
              </Button>
              <Button href="https://field-book-delta.vercel.app" variant="secondary" size="md" external={true}>
                Try Live Prototype ↗
              </Button>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. Our Approach (How Products Are Built) -->
  <section class="section approach-section">
    <div class="container">
      <div class="section-heading">
        <Badge variant="neutral" text="Engineering Philosophy" />
        <h2 class="section-title">Our Approach to Building Software</h2>
        <p class="section-lead">
          We operate as an early-stage studio where engineering integrity matters more than marketing narratives.
        </p>
      </div>

      <div class="principles-grid">
        <div class="principle-card glass-panel">
          <div class="principle-number">01</div>
          <h3 class="principle-title">Problem-First Engineering</h3>
          <p class="principle-desc">
            We identify genuine friction points—such as manual certificate distribution or redundant government paperwork—and build direct, unbloated software solutions.
          </p>
        </div>

        <div class="principle-card glass-panel">
          <div class="principle-number">02</div>
          <h3 class="principle-title">Database-Enforced Integrity</h3>
          <p class="principle-desc">
            Authorization and security belong in the database. In Field Book, 67 Row-Level Security policies and append-only audit designs guarantee safety at the data layer.
          </p>
        </div>

        <div class="principle-card glass-panel">
          <div class="principle-number">03</div>
          <h3 class="principle-title">Grounded AI Boundaries</h3>
          <p class="principle-desc">
            When we integrate LLMs, we strictly ground them with factual system constraints and typed server proxies. We never deploy unconstrained bots that hallucinate policy facts.
          </p>
        </div>

        <div class="principle-card glass-panel">
          <div class="principle-number">04</div>
          <h3 class="principle-title">Exact Technical Disclosures</h3>
          <p class="principle-desc">
            We disclose our exact stack, simulated demo data boundaries, and prototype milestones without exaggerating metrics, traction, or partner affiliations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Built With AI (LLM Usage Disclosure) -->
  <section class="section ai-usage-section">
    <div class="container">
      <div class="ai-box glass-panel">
        <div class="ai-header">
          <Badge variant="in-development" text="AI & LLM Disclosure" />
          <h2 class="ai-title">How We Use AI at Naruka AI Labs</h2>
          <p class="ai-desc">
            Artificial Intelligence is a core amplifier of our development velocity and product features, applied thoughtfully rather than decoratively.
          </p>
        </div>

        <div class="ai-columns-grid">
          <div class="ai-column">
            <h3 class="ai-col-title">In Product Functionality</h3>
            <p class="ai-col-text">
              In <strong>Setu</strong>, we implement a server-side proxy service (<code>/api/v1/chat</code>) backed by the Google Gemini API. The assistant is constrained with concise, grounded system prompts so it reliably explains project mechanisms to demo visitors without hallucinating government procedures.
            </p>
          </div>

          <div class="ai-column">
            <h3 class="ai-col-title">In Engineering Workflows</h3>
            <p class="ai-col-text">
              We use AI coding assistants, including Google Antigravity, Kiro, and Claude, for planning and drafting code. Every change is reviewed by the founder before it ships.
            </p>
          </div>
        </div>

        <div class="ai-footer-note">
          <span>Transparency statement: We do not claim official corporate backing, co-development, or endorsement by third-party model providers. We apply developer APIs and frontier models as independent builders.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Founder Section (Prince Naruka) -->
  <section class="section founder-section">
    <div class="container">
      <div class="section-heading">
        <Badge variant="neutral" text="Studio Leadership" />
        <h2 class="section-title">Founder & Lead Engineer</h2>
      </div>

      <div class="founder-card glass-panel">
        <div class="founder-avatar-wrap">
          <div class="founder-avatar">
            <span>PN</span>
          </div>
          <div class="founder-meta">
            <h3 class="founder-name">Prince Naruka</h3>
            <span class="founder-role">Founder & Engineer · Naruka AI Labs</span>
          </div>
        </div>

        <div class="founder-bio">
          <p>
            I am a software engineer and builder based in India. Naruka AI Labs is my independent product studio where I take projects from hackathons and prototypes into production-grade systems. I believe in writing clean, typed, high-performance software that solves practical workflow friction.
          </p>
        </div>

        <div class="founder-links">
          <a
            href="https://www.linkedin.com/in/prince-naruka-26581236b/"
            target="_blank"
            rel="noopener noreferrer"
            class="founder-link-item"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
            LinkedIn Profile ↗
          </a>
          <a
            href="https://github.com/princeji2"
            target="_blank"
            rel="noopener noreferrer"
            class="founder-link-item"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
            GitHub Profile ↗
          </a>
          <a
            href="mailto:naruka@orgs.social"
            class="founder-link-item email-highlight"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            naruka@orgs.social
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Status & Roadmap (Development Timeline) -->
  <section class="section roadmap-section">
    <div class="container">
      <div class="section-heading">
        <Badge variant="in-development" text="Studio Focus & Plans" />
        <h2 class="section-title">Current Status & Plans</h2>
        <p class="section-lead">
          Overview of active development focus and early exploratory plans across studio projects.
        </p>
      </div>

      <div class="roadmap-grid">
        <div class="roadmap-col glass-panel">
          <div class="roadmap-col-header">
            <span class="roadmap-indicator now-dot"></span>
            <h3 class="roadmap-col-title">Active Focus (In Progress)</h3>
          </div>
          <ul class="roadmap-list">
            <li>Refactor Setu gateway into modular services with standardized department adapters.</li>
            <li>Maintain Field Book prototype at <code>field-book-delta.vercel.app</code>.</li>
            <li>Deploy verified production site for Naruka AI Labs on <code>orgs.social</code>.</li>
            <li>Explore developer APIs and frontier model tooling for product prototyping.</li>
          </ul>
        </div>

        <div class="roadmap-col glass-panel">
          <div class="roadmap-col-header">
            <span class="roadmap-indicator next-dot"></span>
            <h3 class="roadmap-col-title">Exploratory Milestones & Plans</h3>
          </div>
          <ul class="roadmap-list">
            <li>Plan: Research consent token audit trails and cryptographic receipt verification for Setu.</li>
            <li>Plan: Design a visual certificate template builder for Field Book's admin dashboard.</li>
            <li>Explore: Investigate student credential export into open verifiable credential standards.</li>
            <li>Explore: Test early prototypes for domain-grounded assistant tooling.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Bottom Contact CTA -->
  <section class="section bottom-cta-section">
    <div class="container">
      <div class="cta-box glass-panel">
        <h2 class="cta-heading">Interested in collaborating or reviewing our work?</h2>
        <p class="cta-text">
          Whether you are exploring technical collaborations, testing product prototypes, or discussing software architecture, we welcome direct conversations.
        </p>
        <div class="cta-buttons">
          <Button href="mailto:naruka@orgs.social" variant="primary" size="lg">
            Send an Email (naruka@orgs.social) →
          </Button>
          <Button href="https://github.com/princeji2/naruka-ai-labs" variant="secondary" size="lg" external={true}>
            Inspect GitHub Repository
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero-section {
    min-height: calc(85vh - 72px);
    display: flex;
    align-items: center;
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-4xl);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 960px;
  }

  .hero-badge-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: var(--space-lg);
  }

  .location-tag {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .hero-title {
    margin-bottom: var(--space-lg);
  }

  .hero-lead {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    color: var(--text-secondary);
    max-width: 760px;
    margin-bottom: var(--space-2xl);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: var(--space-3xl);
  }

  .hero-truth-banner {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    max-width: 820px;
    text-align: left;
    font-size: 0.85rem;
    color: var(--text-secondary);
    background: rgba(14, 18, 27, 0.7);
  }

  .banner-icon {
    color: var(--accent-indigo-light);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .banner-content strong {
    color: var(--text-primary);
  }

  /* Section Heading */
  .section-heading {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-3xl);
  }

  .section-title {
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
  }

  .section-lead {
    max-width: 680px;
    font-size: 1.05rem;
    color: var(--text-secondary);
  }

  /* Showcase Grid */
  .showcase-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 880px) {
    .showcase-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .showcase-card {
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl));
  }

  .showcase-card-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
  }

  .card-badge-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .card-product-title {
    font-size: 2rem;
    font-weight: 700;
  }

  .card-tagline {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .card-product-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .card-facts-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-md);
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    margin-top: auto;
  }

  .fact-row {
    display: flex;
    flex-direction: column;
    font-size: 0.825rem;
  }

  @media (min-width: 480px) {
    .fact-row {
      flex-direction: row;
      justify-content: space-between;
      gap: 8px;
    }
  }

  .fact-k {
    color: var(--text-muted);
    font-weight: 600;
  }

  .fact-v {
    color: var(--text-primary);
  }

  .card-action-bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-subtle);
  }

  /* Principles Grid */
  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 768px) {
    .principles-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .principle-card {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .principle-number {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--accent-indigo-light);
  }

  .principle-title {
    font-size: 1.25rem;
  }

  .principle-desc {
    font-size: 0.925rem;
    color: var(--text-secondary);
  }

  /* AI Usage Box */
  .ai-box {
    padding: clamp(var(--space-lg), 5vw, var(--space-3xl));
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    background: rgba(13, 16, 24, 0.7);
  }

  .ai-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: 780px;
  }

  .ai-title {
    font-size: 1.85rem;
  }

  .ai-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
  }

  .ai-columns-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 768px) {
    .ai-columns-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ai-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .ai-col-title {
    font-size: 1.15rem;
    color: var(--accent-indigo-light);
  }

  .ai-col-text {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .ai-col-text strong {
    color: var(--text-primary);
  }

  .ai-footer-note {
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Founder Card */
  .founder-card {
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl));
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    background: rgba(14, 18, 27, 0.55);
  }

  .founder-avatar-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .founder-avatar {
    width: 60px;
    height: 60px;
    border-radius: var(--radius-full);
    background: var(--grad-studio-brand);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    color: #FFFFFF;
    flex-shrink: 0;
  }

  .founder-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .founder-name {
    font-size: 1.35rem;
    font-weight: 700;
  }

  .founder-role {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .founder-bio p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .founder-links {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-subtle);
  }

  .founder-link-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-weight: 500;
    padding: 6px 12px;
    border-radius: var(--radius-xs);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
  }

  .founder-link-item:hover {
    color: var(--text-primary);
    border-color: var(--border-glass-hover);
  }

  .email-highlight {
    color: var(--accent-indigo-light);
    font-weight: 600;
  }

  /* Roadmap */
  .roadmap-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 768px) {
    .roadmap-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .roadmap-col {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .roadmap-col-header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .roadmap-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .now-dot {
    background: var(--accent-indigo-light);
    box-shadow: 0 0 10px var(--accent-indigo);
  }

  .next-dot {
    background: var(--text-muted);
  }

  .roadmap-col-title {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .roadmap-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .roadmap-list li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    position: relative;
    padding-left: 18px;
    line-height: 1.5;
  }

  .roadmap-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent-indigo-light);
  }

  .roadmap-list code {
    background: rgba(0, 0, 0, 0.35);
    padding: 1px 4px;
    border-radius: 3px;
    color: #CBD5E1;
  }

