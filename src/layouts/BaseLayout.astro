---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Background from '../components/ui/Background.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalPath?: string;
  /** Adds <meta name="robots" content="noindex, nofollow">. For placeholder pages such as /signin. */
  noindex?: boolean;
}

const {
  title = 'Naruka AI Labs — Practical AI Product Studio',
  description = 'An early-stage, founder-led AI product studio building practical software products, including Setu (interoperability gateway) and Field Book (campus attendance & certificates).',
  ogImage = '/og-image.svg',
  ogType = 'website',
  canonicalPath,
  noindex = false
} = Astro.props;

const siteUrl = 'https://orgs.social';
const canonicalURL = canonicalPath
  ? new URL(canonicalPath, siteUrl).toString()
  : new URL(Astro.url.pathname, siteUrl).toString();

const pageTitle = title.includes('Naruka AI Labs') ? title : `${title} | Naruka AI Labs`;

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Naruka AI Labs',
      url: siteUrl,
      logo: `${siteUrl}/favicon.svg`,
      founder: {
        '@type': 'Person',
        name: 'Prince Naruka',
        url: 'https://www.linkedin.com/in/prince-naruka-26581236b/'
      },
      sameAs: [
        'https://github.com/princeji2/naruka-ai-labs',
        'https://www.linkedin.com/in/prince-naruka-26581236b/'
      ],
      description: 'An independent, founder-led AI product studio building practical software products.'
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Naruka AI Labs',
      publisher: {
        '@id': `${siteUrl}/#organization`
      }
    }
  ]
};
---

<!doctype html>
<html lang="en" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO Primary -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    {/* theme-color must be a literal value (HTML attributes cannot read CSS variables). Keep in sync with --bg in tokens.css. */}
    <meta name="theme-color" content="#1A1D23" />
    <meta name="color-scheme" content="dark" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />
    <meta property="og:site_name" content="Naruka AI Labs" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, siteUrl).toString()} />

    <!-- Critical Font Preloading (Self-Hosted) -->
    <link
      rel="preload"
      href="/fonts/inter-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    <Background />
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
