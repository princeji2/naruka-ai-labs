{
  "name": "naruka-ai-labs-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Official website for Naruka AI Labs (https://orgs.social)",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:secrets": "node scripts/check-secrets.js",
