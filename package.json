    "astro": "^7.3.8",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "^5.7.3"
  }
